#!/bin/sh
# Проверяет, что в файлах интеграции не осталось голых вызовов `openspec`.
#
# Зачем: файлы в .claude/ и .codex/ из коробки написаны под бинарь `openspec` в PATH,
# которого у нас нет, и после генерации патчатся на ./bin/openspec. Если патч не
# наложен (свежий init, апгрейд OpenSpec, ручная правка) — команды /opsx:* упрутся в
# `command not found`, причём молча: гейты сборки этого не видят.
#
# Регулярка намеренно ловит ЛЮБОЙ голый вызов, а не список известных подкоманд:
# перечисление подкоманд уже один раз оказалось уже, чем сам патч, и проверка
# оставалась зелёной при нерабочей интеграции.
#
# Не считается голым вызовом:
#   ./bin/openspec status   — правильная форма (исключено через [^./...])
#   openspec/changes        — путь, а не команда (после openspec нет пробела)
#   $openspec-propose       — имя команды Codex (исключён префикс $)
set -eu

cd "$(dirname "$0")/.."

PATTERN='(^|[^./[:alnum:]_$-])openspec[[:space:]]+[a-z][a-z-]*\b'

if grep -rEn "$PATTERN" .claude .codex; then
	echo "" >&2
	echo "Найдены голые вызовы openspec: интеграция сломана." >&2
	echo "Наложить патч заново — команда в AGENTS.md, раздел про сгенерированные скиллы." >&2
	exit 1
fi

echo "Голых вызовов openspec нет: интеграция .claude/ и .codex/ на ./bin/openspec."
