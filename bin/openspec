#!/bin/sh
# Единственная точка вызова OpenSpec CLI.
#
# Зачем обёртка, а не прямой npx:
#
#   1. Телеметрия. CLI по умолчанию отправляет анонимную статистику использования
#      наружу; отключается только переменной окружения. Держать её в примерах команд
#      недостаточно — забыть префикс на любом новом вызове (propose, show, archive)
#      слишком легко, и тогда данные клиентского проекта уедут молча.
#   2. Версия. Закреплена здесь один раз, а не переписывается в каждом вызове,
#      иначе поведение процесса начнёт зависеть от того, кто какую версию набрал.
#
# CLI сознательно не в зависимостях и не установлен глобально: npx тянет
# закреплённую версию по требованию.
#
# Вызывать из корня репозитория — init/list/validate работают с каталогом openspec/
# относительно текущего каталога, и запуск из web/ создаст структуру не там.
set -eu
exec env OPENSPEC_TELEMETRY=0 npx --yes @fission-ai/openspec@1.7.0 "$@"
