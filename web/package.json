{
  "name": "web",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint .",
    "typecheck": "astro check",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "test": "vitest run && npm run test:render",
    "test:build": "npm run build && vitest run --config vitest.build.config.ts",
    "test:build:remote": "npm run build && PARITY_REMOTE=1 PARITY_REMOTE_STRICT=1 vitest run --config vitest.build.config.ts",
    "test:e2e": "npm run test:e2e:smoke && npm run test:e2e:a11y && npm run test:e2e:payment-preview && npm run test:e2e:payment-stand",
    "test:e2e:smoke": "node tests/helpers/preview-reset.mjs && playwright test tests/site.spec.ts --project=desktop --project=mobile",
    "test:e2e:a11y": "node tests/helpers/preview-reset.mjs && playwright test tests/a11y.spec.ts --project=desktop --project=mobile",
    "test:e2e:catalog": "node tests/helpers/preview-reset.mjs && playwright test tests/article-catalog.spec.ts --project=desktop",
    "test:e2e:seminar": "node tests/helpers/preview-reset.mjs && playwright test tests/seminar-schedule.spec.ts --project=desktop",
    "test:e2e:payment-preview": "PREVIEW_PORT=4323 node tests/helpers/preview-reset.mjs && playwright test tests/payment-form-demo.spec.ts --config=playwright.preview.config.ts",
    "test:e2e:payment-stand": "PREVIEW_PORT=4324 node tests/helpers/preview-reset.mjs && playwright test --config=playwright.stand.config.ts",
    "test:e2e:schedule": "node tests/helpers/preview-reset.mjs && rm -f test-results/schedule-month-run.json && PLAYWRIGHT_JSON_OUTPUT_NAME=test-results/schedule-month-run.json playwright test tests/schedule-month.spec.ts --project=desktop && npm run check:month-run",
    "test:e2e:compat": "node tests/helpers/preview-reset.mjs && playwright test tests/compat.spec.ts --project=compat-chrome-desktop --project=compat-firefox-desktop --project=compat-safari-desktop --project=compat-ios-iphone-se --project=compat-ios-iphone-14 --project=compat-ios-ipad --project=compat-android-chrome",
    "test:e2e:smoke:attached": "playwright test tests/site.spec.ts --config=playwright.attached.config.ts --project=desktop --project=mobile",
    "test:e2e:compat:attached": "playwright test tests/compat.spec.ts --config=playwright.attached.config.ts --project=compat-chrome-desktop --project=compat-firefox-desktop --project=compat-safari-desktop --project=compat-ios-iphone-se --project=compat-ios-iphone-14 --project=compat-ios-ipad --project=compat-android-chrome",
    "test:compare:attached": "playwright test tests/compare.spec.ts --config=playwright.attached.config.ts --project=desktop",
    "verify": "npm test && npm run test:build && npm run test:e2e:smoke && npm run test:e2e:compat",
    "verify:attached": "npm test && npm run test:build && npm run test:e2e:smoke:attached && npm run test:e2e:compat:attached",
    "build:demo": "PAYMENT_ROLE=preview DEMO_FORMS=stub astro build --outDir dist-demo && pagefind --site dist-demo",
    "build:stand": "PAYMENT_ROLE=stand astro build --outDir dist-stand && pagefind --site dist-stand",
    "test:demo": "npm run build:demo && vitest run --config vitest.demo.config.ts",
    "prebuild": "tsx scripts/make-derivatives.ts",
    "media:derivatives": "tsx scripts/make-derivatives.ts --force",
    "prebuild:demo": "tsx scripts/make-derivatives.ts",
    "prebuild:stand": "tsx scripts/make-derivatives.ts",
    "data:refresh": "tsx scripts/refresh-catalog.ts && tsx ../scripts/download-media.ts && tsx scripts/make-derivatives.ts",
    "redirects:gen": "tsx scripts/gen-redirects.ts",
    "data:refresh:dry": "tsx scripts/refresh-catalog.ts --dry",
    "test:e2e:visual": "node tests/helpers/preview-reset.mjs && playwright test tests/visual-baseline.spec.ts --project=desktop --project=mobile",
    "test:e2e:visual:update": "node tests/helpers/preview-reset.mjs && playwright test tests/visual-baseline.spec.ts --project=desktop --project=mobile --update-snapshots",
    "check:month-run": "tsx scripts/check-month-run.ts",
    "test:render": "vitest run --config vitest.render.config.ts"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.2.0",
    "parse5": "^8.0.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/compiler": "^2.13.1",
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.1",
    "eslint": "^10.8.1",
    "eslint-plugin-astro": "^3.1.0",
    "globals": "^17.11.0",
    "pagefind": "^1.5.2",
    "sharp": "^0.35.3",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.2",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "nanoid": "3.3.18"
  }
}
