---
// Layout-вариант с верхней навигацией (редизайн B). Тот же <head> и аналитика,
// что у SidebarLayout (через общие компоненты) — варианты не расходятся по SEO.
// Сайдбара нет: полную перелинковку держит футер.
interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
  schema?: Record<string, unknown>;
  preloadHero?: boolean;
}

import HeadMeta from '../components/HeadMeta.astro';
import MotionScript from '../components/MotionScript.astro';
import TopNav from '../components/topnav/TopNav.astro';
import Footer from '../components/Footer.astro';
import Analytics from '../components/Analytics.astro';
import { isDemoForms } from '../lib/forms';
import '../styles/global.css';

const {
  title,
  description = 'Институт клинической прикладной кинезиологии — ведущий центр постдипломного образования в области холистической медицины.',
  ogImage,
  noindex = false,
  schema,
  preloadHero = false,
} = Astro.props;
---

<!doctype html>
<html lang="ru">
  <head>
    <HeadMeta
      title={title}
      description={description}
      ogImage={ogImage}
      noindex={noindex}
      schema={schema}
      preloadHero={preloadHero}
    />
    <MotionScript />
  </head>
  <body class="layout-topnav">
    {isDemoForms && (
      <div class="demo-banner">
        Демо-стенд: формы заявки отключены, обращения в CRM не создаются
      </div>
    )}
    <TopNav />
    {/* noindex-страницы (превью вариантов) не индексируются и внутренним
        поиском Pagefind — иначе черновик всплыл бы в результатах на проде */}
    <main data-pagefind-body={noindex ? undefined : true} data-pagefind-ignore={noindex ? true : undefined}>
      <slot />
    </main>
    <Footer />
    <Analytics />
  </body>
</html>

<style>
  /* Баннер демо-стенда: виден только когда сборка сделана с DEMO_FORMS */
  .demo-banner {
    background: #8a5a00;
    color: #fff;
    text-align: center;
    font-size: 0.8rem;
    font-weight: 600;
    padding: 0.4rem 1rem;
  }
</style>
