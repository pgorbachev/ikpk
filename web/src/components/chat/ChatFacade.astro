---
// Штатный SDK Bitrix получает настроенный адрес и загружается при обычной загрузке
// страницы. Сайт оставляет только доступный с клавиатуры helper для native chooser.
//
// Рендерится ТОЛЬКО в состоянии 1 конфигурации (адрес объявлен) И вне демо-вывода.
// Без второго условия фасад ориентировался только на наличие адреса: измерено, что
// `CHAT_LOADER_SRC=<реальный адрес> DEMO_FORMS=stub npm run build` вносил живой адрес и
// разметку фасада в 286 страниц демо-вывода.
//
// Признак — `isDemoOutput`, а НЕ `isDemoForms`, и это решение владельца от 2026-09-05:
// выкладываемый стенд есть прод-лайк (staging, UAT) и обязан показывать то же, что
// покажет боевой сайт. Гасится только `dist-demo`, который никуда не выкладывается.
// Прежняя редакция гасила и стенд, потому что оба артефакта делили один флаг, — и
// заказчик на приёмке видел вместо виджета отзывов голую ссылку.
//
// Отличие стенда от боя переехало туда, где ему место: в АДРЕСАТА. Загрузчик для стенда
// указывает на тестовый портал, а пока такого адреса нет — конфигурация объявляет
// отсутствие явно, и чата на стенде не будет. Подставлять портал заказчика нельзя:
// обращения приёмщиков ушли бы в живые Открытые линии.
//
// В состояниях «отсутствие объявлено явно» и «не объявлено ничего» фасада нет вовсе —
// своего блока часов работы или заглушки на этот случай возможность не заводит.
import { chatLoaderConfig, isDemoOutput } from '../../lib/external-widgets';


const config = chatLoaderConfig();
const showFacade = config.state === 'address' && !isDemoOutput;
---

{
  showFacade && (
    <div data-chat-facade class="chat-facade">
      <button
        type="button"
        data-chat-trigger
        data-chat-loader-src={config.src}
        class="chat-trigger"
        aria-label="Написать нам"
      >
        <span>Написать нам</span>
      </button>
    </div>
  )
}

<script is:inline>
  // `is:inline`, а не обычный обрабатываемый тег скрипта.
  //
  // ВНУТРИ ЭТОГО ТЕЛА нельзя писать угловые скобки со словом script подряд (ни в
  // виде открывающего, ни закрывающего тега, даже в комментарии): hazard-scan
  // разбирает собранный HTML собственным упрощённым сканером тегов, а не
  // парсером, и такая подстрока внутри тела читается им как начало ЕЩЁ ОДНОГО
  // тега — один настоящий тег скрипта делится на две ложные записи с разными
  // хешами тела, и обе перестают совпадать с зарегистрированным слотом.
  // Измерено на этом же файле при первой редакции комментария: 1078 вхождений
  // по всему сайту стали неопознанными вместо ожидаемых по одному на маршрут.
  //
  // Обычный обрабатываемый тег Astro бандлит скрипт в общий модульный чанк, и
  // сверка исполняемого вывода (rich-content-safety/hazard-scan) не может
  // отличить его тело от любого другого бандленного `type="module"` скрипта —
  // сравнение тела для таких узлов пропускается по построению
  // (`provenanceError`, `bundledModule`). На странице 404, где фасад не
  // подключён вовсе, чужой необандленный module-скрипт (шапка) тогда ложно
  // приписывался бы слоту фасада — измерено `external-widgets-registry.test.ts`,
  // «на маршруте 404 вхождений со слотом фасада нет». `is:inline` — тот же
  // приём, которым это уже решено для `Analytics.astro` (тоже исключается по
  // странице/сборке).
  //
    (function () {
    const trigger = document.querySelector('[data-chat-trigger]');
    if (!trigger) return;
    const pageScrollport = document.querySelector('[data-page-scrollport]');
    if (pageScrollport && document.body.hasAttribute('data-chat-page')) {
      const viewport = window.visualViewport;
      const updateViewport = function () {
        const height = viewport ? viewport.height : window.innerHeight;
        const offset = viewport ? viewport.offsetTop : 0;
        const setPixel = function (name, value) {
          const next = Math.max(0, value) + 'px';
          if (document.body.style.getPropertyValue(name) !== next) document.body.style.setProperty(name, next);
        };
        const setPosition = function (name, value) {
          if (document.body.style.getPropertyValue(name) !== value) document.body.style.setProperty(name, value);
        };
        setPixel('--chat-viewport-height', height);
        setPixel('--chat-viewport-offset', offset);
        const portRect = pageScrollport.getBoundingClientRect();

        // Popups are children of the sticky header, but the page scrollport clips
        // them. Measure their actual anchors against that clip so a demo banner,
        // sticky header, or reduced visual viewport cannot hide the last controls.
        const header = document.querySelector('header.topnav');
        const menuAnchor = header && header.querySelector('.topnav-mobile > summary');
        const visibleBottom = Math.min(portRect.bottom, offset + height);
        const visibleTop = Math.max(portRect.top, offset);
        const footer = pageScrollport.querySelector('footer.footer');
        const launcherClearance = footer ? parseFloat(getComputedStyle(footer).paddingBottom) || 0 : 0;
        const launcherLeft = window.innerWidth - 116;
        const launcherRight = window.innerWidth - 50;
        const safePopupBottom = function (popupRect) {
          const overlapsLauncherColumn = popupRect && popupRect.width > 0
            && popupRect.left < launcherRight && popupRect.right > launcherLeft;
          return overlapsLauncherColumn ? Math.max(visibleTop, visibleBottom - launcherClearance) : visibleBottom;
        };
        document.querySelectorAll('.topnav-menu .dropdown').forEach(function (dropdown) {
          const parent = dropdown.parentElement;
          const anchor = parent && parent.querySelector(':scope > a, :scope > button');
          const anchorRect = anchor && anchor.getBoundingClientRect();
          const dropdownRect = dropdown.getBoundingClientRect();
          const dropdownBottom = safePopupBottom(dropdownRect);
          const below = anchorRect
            ? Math.max(0, dropdownBottom - Math.max(visibleTop, anchorRect.bottom))
            : Math.max(0, dropdownBottom - visibleTop);
          const above = anchorRect
            ? Math.max(0, Math.min(visibleBottom, anchorRect.top) - visibleTop)
            : 0;
          const placeAbove = above > below;
          setPixel('--chat-nav-dropdown-max-height', placeAbove ? above : below);
          setPosition('--chat-nav-dropdown-top', placeAbove ? 'auto' : '100%');
          setPosition('--chat-nav-dropdown-bottom', placeAbove ? '100%' : 'auto');
        });
        const anchorRect = menuAnchor && menuAnchor.getBoundingClientRect();
        const menuDrawer = header && header.querySelector('.topnav-mobile .topnav-drawer');
        const drawerBottom = safePopupBottom(menuDrawer && menuDrawer.getBoundingClientRect());
        const drawerBelow = anchorRect
          ? Math.max(0, drawerBottom - Math.max(visibleTop, anchorRect.bottom + 8))
          : drawerBottom - visibleTop;
        const drawerAbove = anchorRect
          ? Math.max(0, Math.min(visibleBottom, anchorRect.top - 8) - visibleTop)
          : 0;
        const placeDrawerAbove = drawerAbove > drawerBelow;
        setPixel('--chat-drawer-max-height', placeDrawerAbove ? drawerAbove : drawerBelow);
        const drawerGap = placeDrawerAbove
          ? Math.max(8, anchorRect ? anchorRect.top - visibleBottom : 8)
          : Math.max(8, anchorRect ? visibleTop - anchorRect.bottom : 8);
        setPosition('--chat-drawer-top', placeDrawerAbove ? 'auto' : 'calc(100% + ' + drawerGap + 'px)');
        setPosition('--chat-drawer-bottom', placeDrawerAbove ? 'calc(100% + ' + drawerGap + 'px)' : 'auto');

        if (header) {
          const headerRect = header.getBoundingClientRect();
          const searchBottom = Math.max(visibleTop, visibleBottom - launcherClearance);
          const searchBelow = Math.max(0, searchBottom - Math.max(visibleTop, headerRect.bottom));
          const searchAbove = Math.max(0, Math.min(visibleBottom, headerRect.top) - visibleTop);
          const placeSearchAbove = searchAbove > searchBelow;
          setPixel('--chat-search-max-height', placeSearchAbove ? searchAbove : searchBelow);
          const searchGap = placeSearchAbove
            ? Math.max(0, headerRect.top - visibleBottom)
            : Math.max(0, visibleTop - headerRect.bottom);
          setPosition('--chat-search-top', placeSearchAbove ? 'auto' : 'calc(100% + ' + searchGap + 'px)');
          setPosition('--chat-search-bottom', placeSearchAbove ? 'calc(100% + ' + searchGap + 'px)' : 'auto');
        }

      };
      const scrollHistoryKey = '__ikpkChatPageScroll';
      const scrollHistoryStorageKey = 'ikpk.chat-page-scroll.v1';
      const scrollPositions = new Map();
      const entryId = function () {
        return window.crypto && typeof window.crypto.randomUUID === 'function'
          ? window.crypto.randomUUID()
          : Date.now().toString(36) + '-' + Math.random().toString(36).slice(2);
      };
      const historyState = function () {
        const current = history.state;
        return current && typeof current === 'object' ? Object.assign({}, current) : {};
      };
      const activeScrollEntry = function () {
        const current = history.state && history.state[scrollHistoryKey];
        return current && typeof current.id === 'string' ? current : null;
      };
      const writeScrollEntry = function (top, renewId, known) {
        const state = historyState();
        const current = state[scrollHistoryKey];
        const id = !renewId && current && typeof current.id === 'string' ? current.id : entryId();
        const position = Number.isFinite(top) ? Math.max(0, top) : pageScrollport.scrollTop;
        state[scrollHistoryKey] = { id: id, top: position, known: known !== false };
        history.replaceState(state, '');
        if (known !== false) scrollPositions.set(id, position);
        return id;
      };
      const loadScrollPositions = function () {
        try {
          const saved = sessionStorage.getItem(scrollHistoryStorageKey);
          const entries = saved && JSON.parse(saved);
          if (!Array.isArray(entries)) return;
          entries.forEach(function (entry) {
            if (Array.isArray(entry) && typeof entry[0] === 'string'
              && typeof entry[1] === 'number' && Number.isFinite(entry[1])) {
              scrollPositions.set(entry[0], entry[1]);
            }
          });
        } catch {
          // Storage is optional; history.state still preserves the current entry.
        }
      };
      const rememberScrollPosition = function () {
        const current = activeScrollEntry();
        if (current) scrollPositions.set(current.id, pageScrollport.scrollTop);
      };
      const rememberCurrentHistoryPosition = function () {
        writeScrollEntry(pageScrollport.scrollTop, false, true);
      };
      const saveHistoryPosition = function () {
        rememberCurrentHistoryPosition();
        try {
          sessionStorage.setItem(scrollHistoryStorageKey, JSON.stringify(Array.from(scrollPositions.entries())));
        } catch {
          // Keep chat scrolling usable when browser storage is unavailable or full.
        }
      };
      const scrollEntryPosition = function (entry) {
        if (!entry || typeof entry.id !== 'string') return null;
        if (scrollPositions.has(entry.id)) return scrollPositions.get(entry.id);
        return entry.known === true && typeof entry.top === 'number' && Number.isFinite(entry.top) ? entry.top : null;
      };
      const ensureScrollEntry = function () {
        const current = activeScrollEntry();
        if (!current) writeScrollEntry(pageScrollport.scrollTop, false, false);
        else if (current.known === true && !scrollPositions.has(current.id)
          && typeof current.top === 'number' && Number.isFinite(current.top)) {
          scrollPositions.set(current.id, current.top);
        }
      };
      loadScrollPositions();
      ensureScrollEntry();
      let traversingHistory = false;
      let transitionGeneration = 0;
      let suppressedScrollTop = null;
      let pendingNativeHash = '';
      let freshHashPush = false;
      document.addEventListener('click', function (event) {
        if (event.defaultPrevented || event.button !== 0 || event.altKey || event.ctrlKey || event.metaKey || event.shiftKey) return;
        const target = event.target;
        const anchor = target instanceof Element ? target.closest('a[href]') : null;
        if (!anchor || anchor.hasAttribute('download') || (anchor.target && anchor.target !== '_self')) return;
        const destination = anchor;
        if (destination.origin === window.location.origin
          && destination.pathname === window.location.pathname
          && destination.search === window.location.search
          && destination.hash !== window.location.hash) {
          transitionGeneration += 1;
          traversingHistory = false;
          rememberCurrentHistoryPosition();
          pendingNativeHash = destination.hash;
        }
      }, true);
      window.addEventListener('hashchange', function () {
        if (pendingNativeHash && pendingNativeHash === window.location.hash) {
          transitionGeneration += 1;
          traversingHistory = false;
          pendingNativeHash = '';
          freshHashPush = true;
          writeScrollEntry(pageScrollport.scrollTop, true, true);
          window.setTimeout(function () { freshHashPush = false; }, 0);
          return;
        }
        if (!traversingHistory) {
          transitionGeneration += 1;
          writeScrollEntry(pageScrollport.scrollTop, true, true);
        }
      });
      window.addEventListener('popstate', function () {
        if (freshHashPush) return;
        if (pendingNativeHash && pendingNativeHash === window.location.hash) {
          freshHashPush = true;
          return;
        }
        pendingNativeHash = '';
        traversingHistory = true;
        const generation = ++transitionGeneration;
        const targetEntry = activeScrollEntry();
        const targetPosition = scrollEntryPosition(targetEntry);
        window.setTimeout(function () {
          if (generation !== transitionGeneration) return;
          traversingHistory = false;
          const currentEntry = activeScrollEntry();
          if (targetEntry && currentEntry && targetEntry.id === currentEntry.id && targetPosition !== null) {
            pageScrollport.scrollTo({ top: targetPosition, behavior: 'instant' });
            suppressedScrollTop = pageScrollport.scrollTop;
          }
        }, 0);
      });
      pageScrollport.addEventListener('keydown', function (event) {
        if (event.target !== pageScrollport || event.defaultPrevented
          || event.altKey || event.ctrlKey || event.metaKey || event.shiftKey) return;
        const portRect = pageScrollport.getBoundingClientRect();
        const header = document.querySelector('header.topnav');
        const headerRect = header && header.getBoundingClientRect();
        const stickyHeaderHeight = headerRect
          ? Math.max(0, Math.min(portRect.bottom, headerRect.bottom) - Math.max(portRect.top, headerRect.top))
          : 0;
        const pageStep = Math.max(1, pageScrollport.clientHeight - stickyHeaderHeight - 24);
        let top;
        switch (event.key) {
          case 'PageDown':
          case ' ':
          case 'Spacebar':
            top = pageScrollport.scrollTop + pageStep;
            break;
          case 'PageUp':
            top = pageScrollport.scrollTop - pageStep;
            break;
          case 'ArrowDown':
            top = pageScrollport.scrollTop + 40;
            break;
          case 'ArrowUp':
            top = pageScrollport.scrollTop - 40;
            break;
          case 'Home':
            top = 0;
            break;
          case 'End':
            top = pageScrollport.scrollHeight;
            break;
          default:
            return;
        }
        event.preventDefault();
        pageScrollport.scrollTo({ top: top, behavior: 'instant' });
      });
      const revealFocusedField = function () {
        const focused = document.activeElement;
        if (!(focused instanceof HTMLElement) || !pageScrollport.contains(focused)
          || focused.closest('header')
          || !focused.matches('a[href], button, input, textarea, select, [contenteditable="true"]')) return;
        const portRect = pageScrollport.getBoundingClientRect();
        const fieldRect = focused.getBoundingClientRect();
        const header = document.querySelector('header.topnav');
        const headerBottom = header ? header.getBoundingClientRect().bottom : portRect.top;
        const fieldVisibleTop = Math.max(portRect.top, viewport ? viewport.offsetTop : 0, Math.min(portRect.bottom, headerBottom));
        const visibleBottom = (viewport ? viewport.offsetTop : 0) + (viewport ? viewport.height : window.innerHeight);
        const footer = pageScrollport.querySelector('footer.footer');
        const launcherLeft = window.innerWidth - 116;
        const launcherRight = window.innerWidth - 50;
        const overlapsLauncherColumn = fieldRect.left < launcherRight && fieldRect.right > launcherLeft;
        const launcherClearance = overlapsLauncherColumn && footer
          ? parseFloat(getComputedStyle(footer).paddingBottom) || 0
          : 0;
        const fieldVisibleBottom = Math.min(portRect.bottom, visibleBottom - launcherClearance);
        if (fieldRect.bottom > fieldVisibleBottom) {
          pageScrollport.scrollBy({ top: fieldRect.bottom - fieldVisibleBottom, behavior: 'instant' });
        } else if (fieldRect.top < fieldVisibleTop) {
          pageScrollport.scrollBy({ top: fieldRect.top - fieldVisibleTop, behavior: 'instant' });
        }
      };
      pageScrollport.addEventListener('focusin', revealFocusedField);
      updateViewport();
      const mobileMenu = document.querySelector('header.topnav details.topnav-mobile');
      if (mobileMenu) mobileMenu.addEventListener('toggle', updateViewport);
      const topnavMenu = document.querySelector('header.topnav .topnav-menu');
      if (topnavMenu) {
        topnavMenu.addEventListener('focusin', updateViewport);
        topnavMenu.addEventListener('pointerover', updateViewport);
      }
      window.addEventListener('pageshow', function () {
        transitionGeneration += 1;
        traversingHistory = false;
        loadScrollPositions();
        updateViewport();
        const current = activeScrollEntry();
        const saved = scrollEntryPosition(current);
        if (saved !== null) {
          pageScrollport.scrollTo({ top: saved, behavior: 'instant' });
          suppressedScrollTop = pageScrollport.scrollTop;
        }
      });
      window.addEventListener('resize', function () { updateViewport(); revealFocusedField(); }, { passive: true });
      pageScrollport.addEventListener('scroll', function () {
        updateViewport();
        if (traversingHistory || pendingNativeHash) return;
        if (suppressedScrollTop !== null && pageScrollport.scrollTop === suppressedScrollTop) {
          suppressedScrollTop = null;
          return;
        }
        suppressedScrollTop = null;
        rememberScrollPosition();
      }, { passive: true });
      window.addEventListener('pagehide', saveHistoryPosition);
      if (viewport) {
        viewport.addEventListener('resize', function () { updateViewport(); revealFocusedField(); }, { passive: true });
        viewport.addEventListener('scroll', updateViewport, { passive: true });
      }
    }

    let helperOpenedChooser = false;

    function siteButtons() {
      return window.BX && window.BX.SiteButton && window.BX.SiteButton.buttons;
    }

    function paymentIsOpen() {
      const root = document.getElementById('payment-dialog-root');
      return Boolean(root && !root.hidden);
    }

    function helperIsBlocked() {
      return paymentIsOpen() || trigger.disabled || trigger.closest('[inert]') !== null;
    }

    trigger.addEventListener('click', function () {
      if (helperIsBlocked()) return;
      const buttons = siteButtons();
      if (!buttons || typeof buttons.show !== 'function') return;
      buttons.show();
      helperOpenedChooser = true;
    });

    // The provider owns its chooser and close affordance. Observe a normal click on
    // that affordance so a later, unrelated Escape does not steal focus back here.
    document.addEventListener('click', function (event) {
      if (!helperOpenedChooser) return;
      const target = event.target;
      const close = target instanceof Element
        ? target.closest('.b24-widget-button-inner-item.b24-widget-button-close, .b24-widget-button-close')
        : null;
      if (close) helperOpenedChooser = false;
    }, true);

    document.addEventListener('keydown', function (event) {
      if (event.key !== 'Escape' || !helperOpenedChooser || helperIsBlocked()) return;
      const buttons = siteButtons();
      if (!buttons || buttons.isShown !== true) return;

      // Let Bitrix handle Escape first. If it keeps the chooser open, activate its
      // own close control; never alter or move provider nodes.
      window.setTimeout(function () {
        if (helperIsBlocked()) return;
        const currentButtons = siteButtons();
        if (!currentButtons || currentButtons.isShown !== true) {
          helperOpenedChooser = false;
          trigger.focus({ preventScroll: true });
          return;
        }
        const close = document.querySelector('.b24-widget-button-inner-item.b24-widget-button-close, .b24-widget-button-close');
        if (close instanceof HTMLElement && close.isConnected && close.getClientRects().length > 0) {
          close.click();
          if (currentButtons.isShown === false) {
            helperOpenedChooser = false;
            trigger.focus({ preventScroll: true });
          }
        }
      }, 0);
    }, true);

    const src = trigger.getAttribute('data-chat-loader-src');
    if (src) {
      const script = document.createElement('script');
      script.src = src;
      script.async = true;
      document.body.appendChild(script);
    }
  })();
</script>
