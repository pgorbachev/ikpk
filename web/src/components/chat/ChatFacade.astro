---
// Фасад чата: наша кнопка вызова существует до исполнения стороннего скрипта, а сам
// скрипт загружается только по нажатию — «простой браузера не является триггером»
// (спека change `external-widgets`).
//
// Рендерится ТОЛЬКО в состоянии 1 конфигурации (адрес объявлен) И вне демо-вывода.
// Без второго условия фасад ориентировался только на наличие адреса: измерено, что
// `CHAT_LOADER_SRC=<реальный адрес> DEMO_FORMS=stub npm run build` вносил живой адрес и
// разметку фасада в 286 страниц демо-вывода.
//
// Признак — `isDemoOutput`, а НЕ `isDemoForms`, и это решение владельца от 2026-09-05:
// выкладываемый стенд есть прод-лайк (staging, UAT) и обязан показывать то же, что
// покажет боевой сайт. Гасится только `dist-demo`, который никуда не выкладывается.
// Прежняя редакция гасила и стенд, потому что оба артефакта делили один флаг, — и
// заказчик на приёмке видел вместо виджета отзывов голую ссылку.
//
// Отличие стенда от боя переехало туда, где ему место: в АДРЕСАТА. Загрузчик для стенда
// указывает на тестовый портал, а пока такого адреса нет — конфигурация объявляет
// отсутствие явно, и чата на стенде не будет. Подставлять портал заказчика нельзя:
// обращения приёмщиков ушли бы в живые Открытые линии.
//
// В состояниях «отсутствие объявлено явно» и «не объявлено ничего» фасада нет вовсе —
// своего блока часов работы или заглушки на этот случай возможность не заводит.
import { chatLoaderConfig, isDemoOutput } from '../../lib/external-widgets';


const config = chatLoaderConfig();
const showFacade = config.state === 'address' && !isDemoOutput;
---

{
  showFacade && (
    <div data-chat-facade class="chat-facade">
      <button
        type="button"
        data-chat-trigger
        data-chat-loader-src={config.src}
        class="chat-trigger"
        aria-label="Написать нам"
      >
        <span aria-hidden="true">💬</span>
        <span>Написать нам</span>
      </button>
      <div data-chat-mount class="chat-mount" />
    </div>
  )
}

<script is:inline>
  // `is:inline`, а не обычный обрабатываемый тег скрипта.
  //
  // ВНУТРИ ЭТОГО ТЕЛА нельзя писать угловые скобки со словом script подряд (ни в
  // виде открывающего, ни закрывающего тега, даже в комментарии): hazard-scan
  // разбирает собранный HTML собственным упрощённым сканером тегов, а не
  // парсером, и такая подстрока внутри тела читается им как начало ЕЩЁ ОДНОГО
  // тега — один настоящий тег скрипта делится на две ложные записи с разными
  // хешами тела, и обе перестают совпадать с зарегистрированным слотом.
  // Измерено на этом же файле при первой редакции комментария: 1078 вхождений
  // по всему сайту стали неопознанными вместо ожидаемых по одному на маршрут.
  //
  // Обычный обрабатываемый тег Astro бандлит скрипт в общий модульный чанк, и
  // сверка исполняемого вывода (rich-content-safety/hazard-scan) не может
  // отличить его тело от любого другого бандленного `type="module"` скрипта —
  // сравнение тела для таких узлов пропускается по построению
  // (`provenanceError`, `bundledModule`). На странице 404, где фасад не
  // подключён вовсе, чужой необандленный module-скрипт (шапка) тогда ложно
  // приписывался бы слоту фасада — измерено `external-widgets-registry.test.ts`,
  // «на маршруте 404 вхождений со слотом фасада нет». `is:inline` — тот же
  // приём, которым это уже решено для `Analytics.astro` (тоже исключается по
  // странице/сборке).
  //
  // Сторонний загрузчик исполняется ТОЛЬКО по нажатию — ни на простое браузера, ни
  // предварительным соединением. Один узел на страницу, поэтому querySelector.
  //
  // Загрузка скрипта — не выполнение сценария. Документированный контракт портала
  // (справка Bitrix24, «advanced widget settings»): после исполнения загрузчика
  // глобально стреляет `onBitrixLiveChat` с `event.detail.widget`, у объекта есть
  // `widget.subscribe({ type, callback })` и `widget.open()`; подписка на
  // `BX.LiveChatWidget.SubscriptionType.configLoaded` — документированный способ
  // ждать готовности конфигурации перед открытием. Ни один из известных методов
  // (`open`/`close`/`subscribe`/`setUserRegisterData`/`setCustomData`/`setOption`/
  // `addLocalize`) не даёт доступа к DOM-узлу собственного интерфейса портала, и
  // документация не описывает, куда он его вставляет — поэтому `[data-chat-mount]`
  // ниже используется только как контейнер ДЛЯ ЭТОЙ РАЗМЕТКИ, а не как гарантия того,
  // куда попадёт панель портала.
  //
  // Перевод фокуса — из того же ограничения: раз место появления не документировано,
  // сторожим ЛЮБОЙ новый узел в `document.body` и переносим фокус в первый focusable
  // внутри него. Это наилучшее digital-доступное приближение без доступа к реальному
  // порталу (клиент ещё не передал ключи Bitrix24 — docs/client-requests.md, п. 8);
  // проверить точное соответствие макету портала можно только на живом стенде.
  (function () {
    const pageScrollport = document.querySelector('[data-page-scrollport]');
    if (pageScrollport && document.body.hasAttribute('data-chat-page')) {
      const viewport = window.visualViewport;
      const updateViewport = function () {
        const height = viewport ? viewport.height : window.innerHeight;
        const offset = viewport ? viewport.offsetTop : 0;
        const setPixel = function (name, value) {
          const next = Math.max(0, value) + 'px';
          if (document.body.style.getPropertyValue(name) !== next) document.body.style.setProperty(name, next);
        };
        const setPosition = function (name, value) {
          if (document.body.style.getPropertyValue(name) !== value) document.body.style.setProperty(name, value);
        };
        setPixel('--chat-viewport-height', height);
        setPixel('--chat-viewport-offset', offset);
        const portRect = pageScrollport.getBoundingClientRect();

        // Popups are children of the sticky header, but the page scrollport clips
        // them. Measure their actual anchors against that clip so a demo banner,
        // sticky header, or reduced visual viewport cannot hide the last controls.
        const header = document.querySelector('header.topnav');
        const menuAnchor = header && header.querySelector('.topnav-mobile > summary');
        const visibleBottom = Math.min(portRect.bottom, offset + height);
        const visibleTop = Math.max(portRect.top, offset);
        document.querySelectorAll('.topnav-menu .dropdown').forEach(function (dropdown) {
          setPixel('--chat-nav-dropdown-max-height', visibleBottom - dropdown.getBoundingClientRect().top);
        });
        const anchorRect = menuAnchor && menuAnchor.getBoundingClientRect();
        const drawerBelow = anchorRect ? Math.max(0, visibleBottom - anchorRect.bottom - 8) : visibleBottom - visibleTop;
        const drawerAbove = anchorRect ? Math.max(0, anchorRect.top - visibleTop - 8) : 0;
        const placeDrawerAbove = drawerAbove > drawerBelow;
        setPixel('--chat-drawer-max-height', placeDrawerAbove ? drawerAbove : drawerBelow);
        setPosition('--chat-drawer-top', placeDrawerAbove ? 'auto' : 'calc(100% + 8px)');
        setPosition('--chat-drawer-bottom', placeDrawerAbove ? 'calc(100% + 8px)' : 'auto');

        if (header) {
          const headerRect = header.getBoundingClientRect();
          const searchBelow = Math.max(0, visibleBottom - headerRect.bottom);
          const searchAbove = Math.max(0, headerRect.top - visibleTop);
          const placeSearchAbove = searchAbove > searchBelow;
          setPixel('--chat-search-max-height', placeSearchAbove ? searchAbove : searchBelow);
          setPosition('--chat-search-top', placeSearchAbove ? 'auto' : '100%');
          setPosition('--chat-search-bottom', placeSearchAbove ? '100%' : 'auto');
        }

      };
      const scrollHistoryKey = '__ikpkChatPageScrollTop';
      const saveHistoryPosition = function () {
        const current = history.state;
        const state = current && typeof current === 'object' ? Object.assign({}, current) : {};
        state[scrollHistoryKey] = pageScrollport.scrollTop;
        history.replaceState(state, '');
      };
      const restoreHistoryPosition = function () {
        window.requestAnimationFrame(function () {
          const saved = history.state && history.state[scrollHistoryKey];
          if (typeof saved === 'number' && Number.isFinite(saved)) {
            pageScrollport.scrollTo({ top: saved, behavior: 'instant' });
          }
        });
      };
      const revealFocusedField = function () {
        const focused = document.activeElement;
        if (!(focused instanceof HTMLElement) || !pageScrollport.contains(focused)
          || !focused.matches('main input, main textarea, main select, main [contenteditable="true"]')) return;
        const portRect = pageScrollport.getBoundingClientRect();
        const fieldRect = focused.getBoundingClientRect();
        const header = document.querySelector('header.topnav');
        const headerBottom = header ? header.getBoundingClientRect().bottom : portRect.top;
        const fieldVisibleTop = Math.max(portRect.top, viewport ? viewport.offsetTop : 0, Math.min(portRect.bottom, headerBottom));
        const fieldVisibleBottom = Math.min(portRect.bottom, (viewport ? viewport.offsetTop : 0) + (viewport ? viewport.height : window.innerHeight));
        if (fieldRect.bottom > fieldVisibleBottom) {
          pageScrollport.scrollBy({ top: fieldRect.bottom - fieldVisibleBottom, behavior: 'instant' });
        } else if (fieldRect.top < fieldVisibleTop) {
          pageScrollport.scrollBy({ top: fieldRect.top - fieldVisibleTop, behavior: 'instant' });
        }
      };
      updateViewport();
      restoreHistoryPosition();
      window.addEventListener('resize', function () { updateViewport(); revealFocusedField(); }, { passive: true });
      pageScrollport.addEventListener('scroll', updateViewport, { passive: true });
      window.addEventListener('pagehide', saveHistoryPosition);
      window.addEventListener('pageshow', restoreHistoryPosition);
      if (viewport) {
        viewport.addEventListener('resize', function () { updateViewport(); revealFocusedField(); }, { passive: true });
        viewport.addEventListener('scroll', updateViewport, { passive: true });
      }
    }

    const trigger = document.querySelector('[data-chat-trigger]');
    const mount = document.querySelector('[data-chat-mount]');
    if (!trigger || !mount) return;
    let loaded = false;

    function focusFirstFocusable(root) {
      if (!root || typeof root.querySelector !== 'function') return false;
      const selector = '[tabindex],button,a[href],input,textarea,select,iframe';
      const el = root.matches && root.matches(selector) ? root : root.querySelector(selector);
      if (!el) return false;
      if (!el.hasAttribute('tabindex') && el.tagName !== 'IFRAME' && el.tabIndex < 0) {
        el.setAttribute('tabindex', '-1');
      }
      el.focus();
      return true;
    }

    function watchForInterfaceAndFocus() {
      const observer = new MutationObserver(function (mutations) {
        for (let m = 0; m < mutations.length; m += 1) {
          const added = mutations[m].addedNodes;
          for (let i = 0; i < added.length; i += 1) {
            if (focusFirstFocusable(added[i])) {
              observer.disconnect();
              return;
            }
          }
        }
      });
      observer.observe(document.body, { childList: true, subtree: true });
      window.setTimeout(function () {
        observer.disconnect();
      }, 15000);
    }

    function openWidget(widget) {
      if (!widget || typeof widget.open !== 'function') return;
      watchForInterfaceAndFocus();
      const subscriptionType =
        window.BX && window.BX.LiveChatWidget && window.BX.LiveChatWidget.SubscriptionType
          ? window.BX.LiveChatWidget.SubscriptionType.configLoaded
          : null;
      if (subscriptionType && typeof widget.subscribe === 'function') {
        widget.subscribe({
          type: subscriptionType,
          callback: function () {
            widget.open();
          },
        });
      } else {
        widget.open();
      }
    }

    trigger.addEventListener('click', function () {
      if (loaded) return;
      const src = trigger.getAttribute('data-chat-loader-src');
      if (!src) return;
      loaded = true;

      window.addEventListener('onBitrixLiveChat', function onReady(event) {
        window.removeEventListener('onBitrixLiveChat', onReady);
        openWidget(event && event.detail && event.detail.widget);
      });

      const script = document.createElement('script');
      script.src = src;
      script.async = true;
      document.body.appendChild(script);
    });
  })();
</script>
