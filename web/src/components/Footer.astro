---
import { SOCIAL_LINKS } from '../lib/social';
import { PHONE, PHONE_HREF, MOBILE_PHONE, MOBILE_PHONE_HREF } from '../lib/navigation';
import { socialMarkPresentation } from '../lib/social-marks-registry';
import { assertMarkFilesMatchRegistry } from '../lib/social-mark-files';
import SocialMark from './social-marks/SocialMark.astro';

assertMarkFilesMatchRegistry();
---

<footer class="footer">
  <div class="footer-inner container">
    <div class="footer-grid">
      <div class="footer-col">
        <a href="/" class="footer-logo-link" aria-label="ИКПК — Главная">
          <img src="/logo-icon.svg" alt="" class="footer-logo-icon" width="33" height="34" />
        </a>
        <p class="footer-tagline">
          Институт клинической<br />прикладной кинезиологии
        </p>
        <div class="footer-contacts">
          <a href={PHONE_HREF}>{PHONE}</a>
          <a href={MOBILE_PHONE_HREF}>{MOBILE_PHONE}</a>
          <a href="mailto:info@ikpk.su">info@ikpk.su</a>
        </div>
      </div>

      <div class="footer-col">
        <h2 class="footer-heading">Обучение</h2>
        <ul class="footer-links">
          <li><a href="/institut-klinicheskoy-prikladnoy-kineziologii">Институт клинической прикладной кинезиологии</a></li>
          <li><a href="/institut-apledzhera">Институт Апледжера</a></li>
          <li><a href="/institut-barralya">Институт Барраля</a></li>
          <li><a href="/raspisanie-i-tseny">Расписание и цены</a></li>
          <li><a href="/oplata">Оплата</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h2 class="footer-heading">Компания</h2>
        <ul class="footer-links">
          <li><a href="/svedeniya-ob-obrazovatelnoy-organizatsii">Сведения об организации</a></li>
          <li><a href="/sotrudnichestvo-s-nami">Сотрудничество с нами</a></li>
          <li><a href="/kontakty">Контакты</a></li>
          <li><a href="https://mudriydoctor.ru/" target="_blank" rel="noopener noreferrer">Медицинский центр</a></li>
          <li><a href="https://kinezio.shop/" target="_blank" rel="noopener noreferrer">Магазин</a></li>
          <li><a href="https://disk.yandex.ru/d/8Xr5NSBO0wFUkQ" target="_blank" rel="nofollow noopener noreferrer">Фото</a></li>
          <li><a href="/sitemap">Карта сайта</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h2 class="footer-heading">Подписывайтесь</h2>
        <ul class="footer-links footer-social">
          {SOCIAL_LINKS.map((link) => {
            const presentation = socialMarkPresentation(link.label);
            return (
              <li>
                {presentation === 'text' ? (
                  <a href={link.href} target="_blank" rel="noopener noreferrer">
                    {link.label}
                  </a>
                ) : (
                  <a
                    href={link.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="footer-social-icon"
                    aria-label={link.label}
                  >
                    {presentation === 'themed' ? (
                      <>
                        <span class="footer-social-mark footer-social-mark--default">
                          <SocialMark network={link.label} variant="default" />
                        </span>
                        <span class="footer-social-mark footer-social-mark--dark">
                          <SocialMark network={link.label} variant="dark" />
                        </span>
                      </>
                    ) : (
                      <SocialMark network={link.label} />
                    )}
                  </a>
                )}
              </li>
            );
          })}
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p>© {new Date().getFullYear()} ikpk.su Все права защищены.</p>
      {/* Документ обязателен, и на старом сайте ссылка на него была в футере
          каждой страницы. При переносе она потерялась: файл в сборку попал,
          а дойти до него было нельзя. */}
      <p class="footer-legal">
        <a href="/politika-konfidencialnosti">Пользовательское соглашение и политика конфиденциальности</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-dark-700);
    color: var(--color-gray-300);
    padding: 3rem 0 1.5rem;
    margin-top: 3rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .footer-logo-link {
    display: inline-block;
    text-decoration: none;
  }

  .footer-logo-link:hover { text-decoration: none; }

  .footer-logo-icon {
    width: 33px;
    height: 34px;
    filter: brightness(0) invert(0.6) sepia(1) saturate(3) hue-rotate(80deg);
  }

  .footer-tagline {
    margin-top: 0.5rem;
    font-size: var(--font-s);
    line-height: 1.5;
  }

  .footer-contacts {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin-top: 1rem;
    font-size: var(--font-s);
  }

  .footer-contacts a {
    color: var(--color-gray-300);
    text-decoration: none;
  }

  .footer-contacts a:hover {
    color: var(--color-light-100);
    text-decoration: none;
  }

  .footer-heading {
    color: var(--color-light-100);
    font-size: 0.94rem;
    font-weight: 600;
    margin-bottom: 0.65rem;
    text-transform: none;
    letter-spacing: 0;
    line-height: 1.35;
  }

  .footer-links li {
    margin-bottom: 0.5rem;
    font-size: var(--font-s);
  }

  .footer-links a {
    color: var(--color-gray-300);
    text-decoration: none;
    transition: color 0.15s;
  }

  .footer-links a:hover {
    color: var(--color-light-100);
    text-decoration: none;
  }

  .footer-social {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    gap: 0.65rem;
    padding: 0;
    margin: 0;
  }

  .footer-social li {
    margin-bottom: 0;
  }

  .footer-social a {
    display: inline-flex;
    align-items: center;
    min-width: 24px;
    min-height: 24px;
  }

  .footer-social-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 24px;
    min-height: 24px;
    padding: 0;
    background: none;
    border: none;
    border-radius: 0;
  }

  .footer-social-icon :global(svg) {
    height: 24px;
    width: auto;
    max-height: 24px;
    display: block;
    flex-shrink: 0;
  }

  .footer-social-mark--dark {
    display: none;
  }

  :global(html[data-theme='dark']) .footer-social-mark--default {
    display: none;
  }

  :global(html[data-theme='dark']) .footer-social-mark--dark {
    display: block;
  }

  .footer-bottom {
    padding-top: 1.5rem;
    text-align: center;
    font-size: var(--font-xs);
  }

  .footer-legal {
    margin-top: 0.5rem;
  }

  .footer-legal a {
    color: var(--color-gray-300);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .footer-legal a:hover {
    color: #fff;
  }

  @media (max-width: 768px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 480px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
