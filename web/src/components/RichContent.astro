---
import {
  contextForSafeRichHtml,
  isSafeRichHtml,
  terminalSanitize,
  type SafeRichHtml,
} from '../lib/html-cleaner';

interface Props {
  html: SafeRichHtml | string | { html?: unknown };
  sinkId: string;
}

const { html, sinkId } = Astro.props;
const authenticated = isSafeRichHtml(html);
const raw = authenticated
  ? html.html
  : typeof html === 'string'
    ? html
    : html && typeof html === 'object' && typeof html.html === 'string'
      ? html.html
      : '';
const mode = authenticated ? 'authenticated' : 'untrusted';
const context = authenticated
  ? contextForSafeRichHtml(html) ?? { sourceType: 'sink', sourceId: sinkId }
  : { sourceType: 'sink', sourceId: sinkId };
---
<div data-safe-rich-content={sinkId} set:html={terminalSanitize(raw, mode, context)}></div>
