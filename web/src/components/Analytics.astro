---
// Аналитика (Метрика + Mail.ru top): синхронные заглушки ставят pageview
// сразу, тяжёлые скрипты грузятся после idle. Общий компонент для всех layout.
//
// ВАЖНО про глобальную область (комментарии держим здесь, во frontmatter:
// он не попадает в вывод, а тело <script is:inline> уходит клиенту на всех
// 259 страницах и упирается в бюджет веса 404):
//
// 1. Тело скрипта обёрнуто в IIFE. Сторонние счётчики объявляют свои
//    переменные через var в той же глобальной области, поэтому любое
//    лексическое объявление (const/let) на верхнем уровне здесь даёт
//    «Uncaught SyntaxError: Identifier … has already been declared».
// 2. Очередь Mail.ru ставим ТОЛЬКО через свойство window._tmr, без
//    лексического объявления. Ровно этот баг и был: пара var (из code.js)
//    + лексическое объявление у нас → SyntaxError, который выбрасывался
//    ДО нашего push, так что pageview Mail.ru молча терялся на каждой
//    странице. Гейт в tests/perf-a11y.test.ts закрепляет инвариант.
// 3. Стабы window.ym / window._tmr — присваивание свойств (как в
//    официальных сниппетах), а не объявления: коллизий не создают.
---
<script is:inline>
  (function () {
  // Yandex.Metrika — queue pageview synchronously so it's never lost
  window.ym = window.ym || function (...args) {
    (window.ym.a = window.ym.a || []).push(args);
  };
  window.ym.l = +new Date();
  ym(39506315, 'init', { clickmap: true, trackLinks: true, accurateTrackBounce: true, webvisor: true });

  // Mail.ru — queue pageview synchronously (см. frontmatter, п. 2)
  window._tmr = window._tmr || [];
  window._tmr.push({ id: '3752684', type: 'pageView', start: new Date().getTime() });

  // Defer heavy script downloads
  function _loadAnalyticsScripts() {
    const d = document;
    (function () {
      for (let j = 0; j < d.scripts.length; j += 1) {
        if (d.scripts[j].src === 'https://mc.yandex.ru/metrika/tag.js') return;
      }
      const k = d.createElement('script');
      k.async = true;
      k.src = 'https://mc.yandex.ru/metrika/tag.js';
      d.head.appendChild(k);
    })();
    if (!d.getElementById('tmr-code')) {
      const ts = d.createElement('script');
      ts.async = true;
      ts.id = 'tmr-code';
      ts.src = 'https://top-fwz1.mail.ru/js/code.js';
      d.head.appendChild(ts);
    }
  }
  if ('requestIdleCallback' in window) {
    requestIdleCallback(_loadAnalyticsScripts, { timeout: 3000 });
  } else {
    setTimeout(_loadAnalyticsScripts, 2000);
  }
  })();
</script>
