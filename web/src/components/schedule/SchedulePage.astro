---
import ScheduleControlsScript from './ScheduleControlsScript.astro';
import ScheduleFilters from './ScheduleFilters.astro';
import ScheduleListing from './ScheduleListing.astro';
import SchedulePageHeader from './SchedulePageHeader.astro';
import type { MonthOption } from '../../lib/schedule-months';

interface Option {
  label: string;
  value: string;
}

interface ProgramOption {
  instituteSlug: string;
  name: string;
  slug: string;
}

interface ScheduleItem {
  additionalText: string;
  cityName: string;
  citySlug: string;
  dateLabel: string;
  id: number;
  imageAlt: string;
  imageUrl: string;
  instituteName: string;
  instituteSlug: string;
  months: string[];
  priceLabel: string;
  programName: string;
  programSlug: string;
  registrationHref: string;
  searchIndex: string;
  teacherHref: string;
  teacherLabel: string;
  teacherName: string;
  title: string;
  titleHref: string;
}

interface Props {
  items: ScheduleItem[];
  cities: string[];
  institutes: Option[];
  months: MonthOption[];
  programs: ProgramOption[];
  title: string;
}

const { items, cities, institutes, months, programs, title } = Astro.props as Props;
---

<section class="section schedule-section">
  <SchedulePageHeader title={title} />
  <ScheduleFilters institutes={institutes} programs={programs} cities={cities} months={months} />
  <ScheduleListing items={items} />
  <ScheduleControlsScript />
</section>

<style>
  .schedule-section {
    max-width: 957px;
  }
</style>
