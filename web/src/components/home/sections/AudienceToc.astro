---
/**
 * Editorial: маршруты аудиторий — оглавление из ссылок, не emoji-карточки (§7.2).
 */
const routes = [
  {
    title: 'Я начинаю',
    text: 'Вводные семинары и первые ступени без жёстких предусловий.',
    href: '/raspisanie-i-tseny',
  },
  {
    title: 'Я продолжаю ступень',
    text: 'Последовательности ПК, ФПК, CST, SER и UMAC — от уже пройденного уровня.',
    href: '/institut-klinicheskoy-prikladnoy-kineziologii',
  },
  {
    title: 'Обучение оплачивает организация',
    text: 'Договор, счёт и групповая запись — через контакты института.',
    href: '/kontakty',
  },
];
---
<section class="aud-toc section" data-audience="editorial">
  <div class="aud-toc-inner">
    <h2 class="section-title">С чего начать</h2>
    <ol class="aud-toc-list">
      {routes.map((r) => (
        <li>
          <a href={r.href}>
            <span class="aud-toc-title">{r.title}</span>
            <span class="aud-toc-text">{r.text}</span>
          </a>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .aud-toc-inner {
    max-width: 40rem;
    margin: 0 auto;
    padding: 0 1.5rem;
  }
  .aud-toc-list {
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
    border-top: 1px solid var(--border-default);
  }
  .aud-toc-list li {
    border-bottom: 1px solid var(--border-default);
  }
  .aud-toc-list a {
    display: block;
    padding: 1.1rem 0;
    text-decoration: none;
  }
  .aud-toc-title {
    display: block;
    font-size: 1.15rem;
    font-weight: 650;
    color: var(--text-primary);
  }
  .aud-toc-text {
    display: block;
    margin-top: 0.3rem;
    font-size: var(--font-s);
    color: var(--text-body);
    line-height: 1.45;
  }
  .aud-toc-list a:hover .aud-toc-title {
    color: var(--color-accent-700);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
