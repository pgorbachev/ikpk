---
/**
 * Editorial: три института горизонтальными полосами, не карточками (§7.2).
 */
import { getInstitutes } from '../../../lib/data';
import { getAssetDimensions, srcsetFor } from '../../../lib/media';

const institutes = getInstitutes();
const rows = [
  {
    slug: 'institut-klinicheskoy-prikladnoy-kineziologii',
    blurb:
      'Прикладная кинезиология и остеопатические подходы. Лицензия на образовательную деятельность №3471 от 13.06.2018.',
  },
  {
    slug: 'institut-apledzhera',
    blurb:
      'Краниосакральная терапия по программам Джона Апледжера. Сертификаты с регистрацией в IAHE.',
  },
  {
    slug: 'institut-barralya',
    blurb:
      'Висцеральные и невральные манипуляции по методу Жана-Пьера Барраля.',
  },
];
---
<section class="inst-strips section" data-institutes="editorial">
  <div class="inst-strips-inner">
    <h2 class="section-title">Три института</h2>
    <div class="inst-strips-list">
      {rows.map((row) => {
        const inst = institutes.find((i) => i.slug === row.slug);
        if (!inst) return null;
        const image = inst.images?.[0];
        const dim = image ? getAssetDimensions(image) : undefined;
        return (
          <a class="inst-strip" href={`/${inst.slug}`}>
            {image && (
              <img
                src={image}
                srcset={srcsetFor(image)}
                sizes="160px"
                alt=""
                width={dim?.width ?? 160}
                height={dim?.height ?? 80}
                loading="lazy"
                class="inst-strip-logo"
              />
            )}
            <div class="inst-strip-copy">
              <h3>{inst.name}</h3>
              <p>{row.blurb}</p>
              <span class="inst-strip-link">Программы института →</span>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</section>

<style>
  .inst-strips-inner {
    max-width: 56rem;
    margin: 0 auto;
    padding: 0 1.5rem;
  }
  .inst-strips-list {
    margin-top: 1.5rem;
    border-top: 1px solid var(--border-default);
  }
  .inst-strip {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: 1.5rem;
    align-items: center;
    padding: 1.35rem 0;
    border-bottom: 1px solid var(--border-default);
    text-decoration: none;
    color: inherit;
  }
  .inst-strip-logo {
    width: 160px;
    height: auto;
    max-height: 72px;
    object-fit: contain;
    object-position: left center;
  }
  .inst-strip-copy h3 {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 650;
    color: var(--text-primary);
  }
  .inst-strip-copy p {
    margin: 0.4rem 0 0.55rem;
    font-size: var(--font-s);
    line-height: 1.5;
    color: var(--text-body);
  }
  .inst-strip-link {
    font-size: var(--font-s);
    font-weight: 600;
    color: var(--color-accent-700);
  }

  @media (max-width: 640px) {
    .inst-strip { grid-template-columns: 1fr; gap: 0.75rem; }
    .inst-strip-logo { max-width: 140px; }
  }
</style>
