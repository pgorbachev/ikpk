---
// На главной показаны обе роли из общего каталога специалистов.
import { getTeachers, teacherPageHref } from '../../../lib/data';
import { selectHomepagePeopleByRole } from '../../../lib/home';
import { getAssetDimensions, srcsetFor } from '../../../lib/media';

interface Props {
  limit?: number;
}
const { limit = 8 } = Astro.props;

// Короткое имя: «Фамилия Имя» без длинного хвоста титулов после запятой.
function shortName(full: string): string {
  return full.split(',')[0].trim();
}
function credentials(full: string): string {
  const idx = full.indexOf(',');
  return idx >= 0 ? full.slice(idx + 1).trim() : '';
}

const selected = selectHomepagePeopleByRole(getTeachers(), limit);
const toCards = (people: typeof selected.teachers, role: 'teacher' | 'method-author') => people
  .map((t) => ({
    name: shortName(t.name),
    detail: role === 'method-author' ? 'Автор методики' : credentials(t.name),
    photo: t.photo,
    href: role === 'method-author' ? `/specialisty/${t.slug}` : teacherPageHref(t),
    dim: getAssetDimensions(t.photo),
  }));
const teachers = toCards(selected.teachers, 'teacher');
const authors = toCards(selected.methodAuthors, 'method-author');
---
<section class="teachers section" data-reveal>
  <div class="container">
    <h2 class="section-title">Преподаватели</h2>
    <div class="teachers-grid">
      {teachers.map((t) => t.href ? (
        <a class="teacher-card" href={t.href}>
          <img class="teacher-photo" src={t.photo} srcset={srcsetFor(t.photo)} sizes="(max-width: 640px) 45vw, 260px" alt={t.name} width={t.dim?.width} height={t.dim?.height} loading="lazy" />
          <span class="teacher-name">{t.name}</span>
          {t.detail && <span class="teacher-cred">{t.detail}</span>}
        </a>
      ) : (
        <div class="teacher-card">
          <img class="teacher-photo" src={t.photo} srcset={srcsetFor(t.photo)} sizes="(max-width: 640px) 45vw, 260px" alt={t.name} width={t.dim?.width} height={t.dim?.height} loading="lazy" />
          <span class="teacher-name">{t.name}</span>
          {t.detail && <span class="teacher-cred">{t.detail}</span>}
        </div>
      ))}
    </div>
  </div>
</section>

<section class="teachers section" data-reveal>
  <div class="container">
    <h2 class="section-title">Авторы методик</h2>
    <div class="teachers-grid">
      {authors.map((t) => t.href ? (
        <a class="teacher-card" href={t.href}>
          <img class="teacher-photo" src={t.photo} srcset={srcsetFor(t.photo)} sizes="(max-width: 640px) 45vw, 260px" alt={t.name} width={t.dim?.width} height={t.dim?.height} loading="lazy" />
          <span class="teacher-name">{t.name}</span>
          {t.detail && <span class="teacher-cred">{t.detail}</span>}
        </a>
      ) : (
        <div class="teacher-card">
          <img class="teacher-photo" src={t.photo} srcset={srcsetFor(t.photo)} sizes="(max-width: 640px) 45vw, 260px" alt={t.name} width={t.dim?.width} height={t.dim?.height} loading="lazy" />
          <span class="teacher-name">{t.name}</span>
          {t.detail && <span class="teacher-cred">{t.detail}</span>}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .teachers-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.25rem; }
  .teacher-card {
    display: flex; flex-direction: column; align-items: center; text-align: center; gap: 0.4rem;
    text-decoration: none; color: var(--color-dark-700);
  }
  .teacher-photo {
    width: 100%; height: auto; aspect-ratio: 1 / 1; object-fit: cover; border-radius: 12px;
    background: var(--color-gray-150); transition: transform 0.2s;
  }
  .teacher-card:hover .teacher-photo { transform: translateY(-3px); }
  .teacher-name { font-weight: 600; font-size: var(--font-s); margin-top: 0.4rem; }
  .teacher-cred { font-size: 0.75rem; color: var(--color-gray-500); line-height: 1.3; }
  @media (max-width: 780px) { .teachers-grid { grid-template-columns: repeat(2, 1fr); } }
</style>
