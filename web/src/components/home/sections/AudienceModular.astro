---
/**
 * Modular: маршруты с числами (§7.4). Числа — из реальных данных, не маркетинг.
 */
import { getSeminars } from '../../../lib/data';

const all = getSeminars();
const withPrereq = all.filter((s) =>
  /должен быть пройден|обязательн/i.test(`${s.description_text || ''} ${s.description_html || ''}`)
).length;
const withoutPrereq = all.length - withPrereq;

const routes = [
  {
    title: 'Я начинаю',
    count: withoutPrereq,
    unit: 'семинаров без жёстких предусловий',
    href: '/raspisanie-i-tseny',
  },
  {
    title: 'Я продолжаю',
    count: withPrereq,
    unit: 'семинаров со ступенями',
    href: '/institut-klinicheskoy-prikladnoy-kineziologii',
  },
  {
    title: 'Оплачивает организация',
    count: null as number | null,
    unit: 'счёт, договор, группа — через контакты',
    href: '/kontakty',
  },
];
---
<section class="aud-mod section" data-audience="modular">
  <div class="container">
    <h2 class="section-title">Маршруты обучения</h2>
    <div class="aud-mod-grid">
      {routes.map((r) => (
        <a class="aud-mod-card" href={r.href}>
          <h3>{r.title}</h3>
          {r.count !== null ? (
            <p class="aud-mod-count">
              <strong>{r.count}</strong>
              <span>{r.unit}</span>
            </p>
          ) : (
            <p class="aud-mod-count soft"><span>{r.unit}</span></p>
          )}
          <span class="aud-mod-go">Перейти →</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .aud-mod-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-top: 1.25rem;
  }
  .aud-mod-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.35rem;
    border: 1px solid var(--border-default);
    background: var(--surface-page);
    text-decoration: none;
    color: inherit;
    min-height: 11rem;
  }
  .aud-mod-card h3 {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 650;
    color: var(--text-primary);
  }
  .aud-mod-count {
    margin: 0;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .aud-mod-count strong {
    font-size: 2rem;
    font-weight: 700;
    line-height: 1;
    color: var(--text-primary);
  }
  .aud-mod-count span {
    font-size: var(--font-s);
    color: var(--text-body);
    line-height: 1.4;
  }
  .aud-mod-count.soft { justify-content: flex-end; }
  .aud-mod-go {
    font-size: var(--font-s);
    font-weight: 600;
    color: var(--color-accent-700);
  }

  @media (max-width: 800px) {
    .aud-mod-grid { grid-template-columns: 1fr; }
  }
</style>
