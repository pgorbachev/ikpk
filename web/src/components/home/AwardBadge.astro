---
import type { BadgeDeclaration } from '../../lib/award-badges';

interface Props {
  badge: BadgeDeclaration;
}

const { badge } = Astro.props;
---

<a
  class="award-badge"
  data-award-badge
  data-award-provider={badge.provider.id}
  href={badge.sourceUrl ?? undefined}
  target="_blank"
  rel="noopener"
>
  {badge.provider.id === 'yandex-maps' ? (
    <span class="award-mark award-mark-ym" data-award-icon aria-hidden="true">
      <svg viewBox="0 0 24 24" width="18" height="18" focusable="false">
        <path
          d="M12 1.8c-3.9 0-7 3-7 6.8 0 4.9 5.6 11.4 6.4 12.3.3.4.9.4 1.2 0C13.4 20 19 13.5 19 8.6c0-3.8-3.1-6.8-7-6.8Z"
          fill="#fc3f1d"
        />
        <circle cx="12" cy="8.4" r="2.6" fill="#fff" />
      </svg>
    </span>
  ) : (
    <span class="award-mark award-mark-gis" data-award-icon aria-hidden="true">
      <svg viewBox="0 0 24 24" width="18" height="18" focusable="false">
        <rect x="1" y="3" width="22" height="7" fill="#f2911b" />
        <rect x="1" y="10" width="22" height="11" fill="#5db335" />
        <circle cx="12" cy="11" r="6" fill="#1a8ce0" />
        <path d="m12 7.4 1.3 2.7 2.9.4-2.1 2 .5 2.9-2.6-1.4-2.6 1.4.5-2.9-2.1-2 2.9-.4Z" fill="#fff" />
      </svg>
    </span>
  )}
  <span class="award-copy">
    <span class="award-title" data-award-title>{badge.label ?? 'Знак награды'}</span>
    <span class="award-source" data-award-source>{badge.provider.label}</span>
  </span>
</a>

<style>
  .award-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: #21201f;
    text-decoration: none;
    background: #fff;
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: var(--radius-pill, 999px);
    padding: 0.4rem 0.85rem 0.4rem 0.5rem;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
  }

  .award-mark {
    display: inline-flex;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    align-items: center;
    justify-content: center;
    flex: none;
    background: #f5f6f7;
    overflow: hidden;
  }

  .award-mark-gis svg {
    border-radius: 4px;
  }

  .award-copy {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
    text-align: left;
  }

  /* Плашка белая в обеих темах, поэтому её чернила не берутся из
     инвертирующихся токенов темы. */
  .award-title {
    color: #21201f;
    font-size: var(--font-s);
    font-weight: 600;
  }

  .award-source {
    color: #6f7276;
    font-size: var(--font-xs);
  }
</style>
