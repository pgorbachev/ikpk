---
import type { Seminar } from '../../lib/data';
import { MOBILE_PHONE, MOBILE_PHONE_HREF } from '../../lib/navigation';

interface Props {
  seminar: Seminar;
  href: string;
  nearestDate?: string | null;
}

const { seminar, href, nearestDate = null } = Astro.props as Props;

function escapeRegExp(value: string): string {
  return value.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
}

function clipLead(value: string, maxLength = 720): string {
  if (value.length <= maxLength) return value;
  return `${value.slice(0, maxLength).trimEnd()}…`;
}

const description = (seminar.description_text || '')
  .replace(new RegExp(`^${escapeRegExp(seminar.name)}\\s*`, 'i'), '')
  .replace(/Записаться/gi, '')
  .replace(/\s+/g, ' ')
  .trim();

const lead = description ? clipLead(description) : '';
---

<article class="course-group-seminar-item" data-testid="course-group-seminar-card">
  <div class="cgs-date-row">
    {nearestDate ? (
      <span class="cgs-chip" data-testid="seminar-nearest-date">{nearestDate}</span>
    ) : (
      <>
        <span class="cgs-chip cgs-chip--muted" data-testid="seminar-date-fallback">Даты пока не назначены</span>
        <a class="cgs-phone" href={MOBILE_PHONE_HREF}>уточняйте у менеджера: {MOBILE_PHONE}</a>
      </>
    )}
  </div>
  <a href={href} class="course-group-seminar-main" aria-label={`Семинар "${seminar.name}"`}>
    <h2 class="course-group-seminar-title">{seminar.name}</h2>
    {lead && <p class="course-group-seminar-excerpt">{lead}</p>}
  </a>
  <div class="course-group-seminar-actions">
    <a href={href} class="course-group-seminar-cta" aria-label={`Записаться на семинар ${seminar.name}`}>
      Записаться на семинар
    </a>
  </div>
</article>

<style>
  /* Ближайшая дата семинара (D3/Q11): верхняя строка карточки. */
  .cgs-date-row {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
    margin-bottom: 0.35rem;
  }

  .cgs-chip {
    display: inline-block;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: #efe7d8;
    color: #4a3f2a;
    font-size: 0.85rem;
    font-weight: 600;
  }

  .cgs-chip--muted {
    background: #ecece8;
    color: #5c5c55;
    font-weight: 500;
  }

  .cgs-phone {
    font-size: 0.85rem;
    color: inherit;
  }

  .course-group-seminar-item {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1.25rem;
    align-items: end;
    padding: 1.15rem 1.25rem 1.2rem;
    border-radius: 8px;
    border: 1px solid #d9d9d4;
    background: #fafaf8;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.16);
    transition: box-shadow 0.16s ease, transform 0.16s ease, border-color 0.16s ease;
  }

  .course-group-seminar-item:hover {
    border-color: #cdcdc7;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.18);
    transform: translateY(var(--lift-y-subtle));
  }

  .course-group-seminar-main {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .course-group-seminar-main:hover {
    text-decoration: none;
  }

  .course-group-seminar-title {
    margin: 0;
    font-size: 1.08rem;
    line-height: 1.42;
    color: var(--color-dark-700);
  }

  .course-group-seminar-excerpt {
    margin: 0.65rem 0 0;
    color: var(--color-gray-600);
    font-size: var(--font-s);
    line-height: 1.6;
  }

  .course-group-seminar-actions {
    display: flex;
    align-items: flex-end;
    justify-content: flex-end;
  }

  .course-group-seminar-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    padding: 0 1rem;
    border-radius: 999px;
    background: #2e6e32;
    color: #fff;
    text-decoration: none;
    font-size: var(--font-s);
    font-weight: 600;
    white-space: nowrap;
  }

  .course-group-seminar-cta:hover {
    text-decoration: none;
    background: #285e2b;
  }

  @media (max-width: 768px) {
    .course-group-seminar-item {
      grid-template-columns: 1fr;
      gap: 0.9rem;
      align-items: start;
    }

    .course-group-seminar-actions {
      justify-content: flex-start;
    }

    .course-group-seminar-cta {
      width: 100%;
    }
  }

  :root[data-theme='dark'] .course-group-seminar-item {
    border-color: #434a43;
    background: #232723;
  }

  /* Цвета чипов заданы литералами, поэтому тёмная тема их не подхватывает сама:
     светлый чип на тёмной карточке остался бы единственным ярким пятном. */
  :root[data-theme='dark'] .cgs-chip {
    background: #3a3527;
    color: #e6dcc6;
  }

  :root[data-theme='dark'] .cgs-chip--muted {
    background: #2c302c;
    color: #b9bdb6;
  }
</style>
