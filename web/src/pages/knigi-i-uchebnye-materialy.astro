---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { getBookMarketplaceLinks } from '../lib/book-offers';

const marketplaces = getBookMarketplaceLinks();
---

<BaseLayout title="Книги и учебные материалы — ИКПК" description="Книжные новинки издательского дома ИКПК, акции и ссылки на площадки продавца.">
  <div class="container">
    <Breadcrumbs items={[{ label: 'Книги и учебные материалы' }]} />

    <section class="section">
      <h1 class="page-title">Книги и учебные материалы</h1>
      <p>Издательский дом ИКПК выпускает книги и учебные материалы. Продавец книг — ИП Пилявский Д.С.</p>

      <div class="grid grid-2 book-links">
        <a class="card book-link" href="https://kinezio.shop/novinki/" target="_blank" rel="noopener noreferrer">
          <div class="book-link-media book-link-media--new">
            <img src="/books/new-book.jpg" alt="Обложка книги «Частые железистые дисфункции в общей практике»" width="768" height="1024" loading="lazy" decoding="async" />
            <img src="/books/lymphatic-book.jpg" alt="Обложка книги «Ручные лимфатические техники»" width="768" height="1024" loading="lazy" decoding="async" />
          </div>
          <div class="book-link-content">
            <h2>Новинки книг</h2>
            <p>Открыть каталог продавца на внешнем сайте</p>
          </div>
        </a>
        <a class="card book-link" href="/aktsii-i-skidki">
          <div class="book-link-media book-link-media--sale">
            <img src="/books/sale.jpg" alt="" width="991" height="743" loading="lazy" decoding="async" />
          </div>
          <div class="book-link-content">
            <h2>Sale</h2>
            <p>Акции и скидки</p>
          </div>
        </a>
      </div>

      <h2>Книги на торговых площадках</h2>
      <ul class="marketplace-links">
        {marketplaces.map(({ label, href }) => (
          <li>
            <a class="marketplace-link card" href={href} target="_blank" rel="noopener noreferrer">
              <img src={label === 'Wildberries' ? '/books/wildberries.jpg' : '/books/ozon.webp'} alt="" width="160" height="120" loading="lazy" decoding="async" />
              <span>Перейти на {label} — внешний сайт продавца</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  .page-title { margin-bottom: 1rem; }
  .book-links { margin: 2rem 0 3rem; }
  .book-link { display: flex; flex-direction: column; color: inherit; text-decoration: none; }
  .book-link:hover { text-decoration: none; }
  .book-link-media { display: flex; align-items: center; justify-content: center; height: 16.5rem; overflow: hidden; }
  .book-link-media--new { gap: 1rem; padding: 0.75rem; background: #e8f1e9; }
  .book-link-media--new img { max-width: calc(50% - 0.5rem); }
  .book-link-media--sale { background: #fff2f0; }
  .book-link-media img { width: 100%; height: 100%; object-fit: contain; }
  .book-link-content { padding: 1.25rem 1.5rem 1.5rem; }
  .book-link h2 { margin-bottom: 0.5rem; color: var(--color-dark-700); }
  .book-link p { margin: 0; color: var(--color-gray-600); }
  .marketplace-links { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem; margin-top: 1.5rem; padding: 0; list-style: none; }
  .marketplace-link { display: flex; align-items: center; gap: 1rem; min-height: 7.5rem; padding: 0.75rem; color: var(--color-dark-700); text-decoration: none; }
  .marketplace-link:hover { text-decoration: none; }
  .marketplace-link img { flex: none; width: 8rem; height: 6rem; border-radius: var(--radius-s); object-fit: cover; }
  .marketplace-link span { text-decoration: underline; text-underline-offset: 0.15em; }
  @media (max-width: 768px) {
    .marketplace-links { grid-template-columns: 1fr; }
  }
</style>
