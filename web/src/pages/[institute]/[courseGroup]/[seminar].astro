---
import { scheduleBelongsToSeminar } from '../../../lib/data';
import { seminarTitleFallback, seminarDescriptionFallback } from '../../../lib/seo-fallback';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import SeminarSchedulePanel from '../../../components/seminars/SeminarSchedulePanel.astro';
import SeminarDocuments from '../../../components/seminars/SeminarDocuments.astro';
import {
  getInstitutes,
  getCourseGroups,
  getSeminars,
  getScheduleEntries,
  getTeachers,
  cleanBodyHtml,
  stripLegacySeminarTail, getSeminarBuildNow,
  teacherPageHref,
} from '../../../lib/data';
import type { CourseGroup, Institute, Seminar } from '../../../lib/data';
import RichContent from '../../../components/RichContent.astro';
import { calendarDay, isBeforeStart } from '../../../lib/schedule-window';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths: GetStaticPaths = () => {
  const institutes = getInstitutes();
  const allCGs = getCourseGroups();
  const allSeminars = getSeminars();
  const paths: { params: Record<string, string>; props: Record<string, unknown> }[] = [];

  for (const sem of allSeminars) {
    const cg = allCGs.find((c) => c.legacy_id === sem.course_group_legacy_id);
    if (!cg) continue;
    const inst = institutes.find((i) => i.slug === cg.institute_legacy_id);
    if (!inst) continue;
    paths.push({
      params: { institute: inst.slug, courseGroup: cg.slug, seminar: sem.slug },
      props: { seminar: sem, courseGroup: cg, institute: inst },
    });
  }
  return paths;
};

const { seminar, courseGroup, institute } = Astro.props as {
  seminar: Seminar;
  courseGroup: CourseGroup;
  institute: Institute;
};

// Dated offers expire at start; the description and route remain available.
const today = getSeminarBuildNow();
const schedule = getScheduleEntries().filter(
  (e) => scheduleBelongsToSeminar(e, seminar) && e.status === 'active' && isBeforeStart(e, today)
);
const sortedSchedule = [...schedule].sort(
  (a, b) => calendarDay(a.startAt).localeCompare(calendarDay(b.startAt))
);
const allTeachers = getTeachers();
const seminarUrl = `https://ikpk.su/${institute.slug}/${courseGroup.slug}/${seminar.slug}`;
const scheduleRows = sortedSchedule.map((entry) => ({
  entry,
  teachers: (entry.teachers || []).map((teacher) => {
    const full = allTeachers.find(
      (candidate) =>
        candidate.slug === String(teacher.id) ||
        candidate.legacy_id === String(teacher.id) ||
        candidate.name === teacher.fullName
    );

    return {
      fullName: teacher.fullName,
      href: teacherPageHref(full),
    };
  }),
}));
const structuredContent = seminar.content_format === 'structured';
const seminarBodyParts = [
  seminar.description_html ? stripLegacySeminarTail(seminar.description_html) : '',
  seminar.full_text_html ?? '',
  seminar.learning_mode ? `<h2>Как проходит обучение</h2>${seminar.learning_mode}` : '',
  seminar.learning_plan ? `<h2>Учебный план</h2>${seminar.learning_plan}` : '',
  seminar.recommendations ?? '',
].filter((html) => html.trim().length > 0);
const seminarBodyHtml = !structuredContent && seminarBodyParts.length
  ? cleanBodyHtml(seminarBodyParts.join('\n'), Astro.url.pathname)
  : '';
const cleanSection = (html: string) => cleanBodyHtml(html, { type: 'seminar', id: seminar.slug });
const sectionKeys = ['audience', 'learning_plan', 'learning_mode', 'documents', 'recommendations'] as const;
const fallbackId = (key: string) => `seminar-${key.replaceAll('_', '-')}`;
const anchorMap: Record<string, { id: string; aliases: string[] }> = {};
if (structuredContent) {
  const input = seminar.content_section_anchors;
  const failAnchors = () => { throw new Error(`Некорректные якоря разделов семинара ${seminar.slug}`); };
  if (input != null && (typeof input !== 'object' || Array.isArray(input))) failAnchors();
  const used = new Set<string>();
  for (const [key, value] of Object.entries(input ?? {})) {
    if (!sectionKeys.includes(key as typeof sectionKeys[number])) failAnchors();
    const values = typeof value === 'string' ? [value] : value;
    if (!Array.isArray(values) || !values.length || values.some((v) => typeof v !== 'string' || !/^[A-Za-z0-9_.:-]+$/.test(v))) failAnchors();
    const legacySections = values.filter((v) => /^section-[1-9]\d*$/.test(v));
    if (legacySections.length > 1) failAnchors();
    const id = legacySections[0] || fallbackId(key);
    for (const v of values) {
      if (used.has(v) || sectionKeys.some((other) => other !== key && fallbackId(other) === v)) failAnchors();
      used.add(v);
    }
    anchorMap[key] = { id, aliases: values.filter((v) => v !== id) };
  }
}
const sectionId = (key: string) => anchorMap[key]?.id ?? fallbackId(key);
const sectionAliases = (key: string) => anchorMap[key]?.aliases ?? [];
const sections = [
  { key: 'audience', title: 'Для кого подойдёт', html: seminar.audience },
  { key: 'learning_plan', title: 'Учебный план', html: seminar.learning_plan },
  { key: 'learning_mode', title: 'Как проходит обучение', html: seminar.learning_mode },
];

// Описание для схемы: у части семинаров нет ни seo-описания, ни секций (живой
// API отдаёт их пустыми — таких 5 из 126). Пустое description ломает разметку
// Course, поэтому цепочка отступлений заканчивается осмысленным текстом,
// собранным из имеющихся фактов, а не заглушкой «нет описания».
// Заголовок и описание страницы. У 11 семинаров, появившихся при обновлении
// каталога, seo-полей нет в природе: живой сайт собирает их шаблоном на месте.
// Подстановка пустого значения оставляла страницу без <title> — это и потеря
// сниппета в поиске, и нарушение доступности (axe: document-title).
const pageTitle =
  seminar.seo_title?.trim() ||
  seminarTitleFallback(seminar.name, institute.slug, institute.name);
const pageDescription =
  seminar.seo_description?.trim() ||
  seminarDescriptionFallback(seminar.name, courseGroup.name, institute.slug, institute.name);

const schemaDescription =
  seminar.seo_description?.trim() ||
  seminar.description_text?.slice(0, 200) ||
  pageDescription;

// Event без startDate невалиден (Google Rich Results) — Этап 3, план 004.
// Семинар с назначенной датой → Event; без даты → Course (программа обучения).
const seminarSchema =
  schedule.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'Event',
        name: seminar.name,
        description: schemaDescription,
        url: seminarUrl,
        organizer: {
          '@type': 'EducationalOrganization',
          name: 'ИКПК',
          url: 'https://ikpk.su',
        },
        location: schedule[0].city?.name && schedule[0].city.name !== 'Онлайн' ? {
          '@type': 'Place',
          name: 'ИКПК',
          address: {
            '@type': 'PostalAddress',
            addressLocality: schedule[0].city.name,
          },
        } : undefined,
        startDate: calendarDay(schedule[0].startAt),
        endDate: calendarDay(schedule[0].endAt),
        eventStatus: 'https://schema.org/EventScheduled',
        eventAttendanceMode: schedule[0].city?.name === 'Онлайн'
          ? 'https://schema.org/OnlineEventAttendanceMode'
          : 'https://schema.org/OfflineEventAttendanceMode',
        offers: schedule[0].isFree === true || (Number.isFinite(schedule[0].newPrice) && schedule[0].newPrice > 0) ? {
          '@type': 'Offer',
          url: seminarUrl,
          price: schedule[0].isFree === true ? '0' : String(schedule[0].newPrice),
          priceCurrency: 'RUB',
          availability: 'https://schema.org/InStock',
        } : undefined,
      }
    : {
        '@context': 'https://schema.org',
        '@type': 'Course',
        name: seminar.name,
        description: schemaDescription,
        url: seminarUrl,
        provider: {
          '@type': 'EducationalOrganization',
          name: 'ИКПК',
          url: 'https://ikpk.su',
        },
      };
---

<BaseLayout title={pageTitle} description={pageDescription} schema={seminarSchema}>
  <div class="container">
    <Breadcrumbs
      items={[
        { label: institute.name, href: `/${institute.slug}` },
        { label: courseGroup.name, href: `/${institute.slug}/${courseGroup.slug}` },
        { label: seminar.name },
      ]}
    />

    <article class="section seminar-detail">
      <h1 class="page-title">{seminar.name}</h1>

      <div class="seminar-cols">
        <SeminarSchedulePanel rows={scheduleRows} />

        <div class="seminar-main">
          {structuredContent ? (
            <div class="seminar-content rich-content">
              {seminar.description_html && <RichContent html={cleanSection(seminar.description_html)} sinkId="seminar-description" />}
              {sections.map((section) => section.html?.trim() && (
                <>
                  {sectionAliases(section.key).map((id) => <span id={id} aria-hidden="true"></span>)}
                  <details open id={sectionId(section.key)}><summary>{section.title}</summary><RichContent html={cleanSection(section.html)} sinkId={`seminar-${section.key}`} /></details>
                </>
              ))}
              <SeminarDocuments seminar={seminar} id={sectionId('documents')} aliases={sectionAliases('documents')} />
              {seminar.recommendations?.trim() && (
                <>
                  {sectionAliases('recommendations').map((id) => <span id={id} aria-hidden="true"></span>)}
                  <details open id={sectionId('recommendations')}><summary>Рекомендации</summary><RichContent html={cleanSection(seminar.recommendations)} sinkId="seminar-recommendations" /></details>
                </>
              )}
            </div>
          ) : seminarBodyHtml ? (
            <div class="seminar-content rich-content">
              <RichContent html={seminarBodyHtml} sinkId="seminar-body" />
            </div>
          ) : seminar.description_text && (
            <div class="seminar-content rich-content">
              <p>{seminar.description_text}</p>
            </div>
          )}
        </div>
      </div>
    </article>
  </div>
</BaseLayout>

<style>
  .page-title {
    margin: 0 0 1.75rem;
    font-size: clamp(2rem, 1.65rem + 1.2vw, 3rem);
    line-height: 1.12;
  }

  .seminar-content {
    margin-bottom: 0;
    line-height: 1.75;
  }

  /*
   * Расписание — в боковой колонке справа, описание слева (вариант C, выбор
   * владельца 23.08.2026). Раскладка живёт здесь, а не в компоненте: место блока
   * на странице задаёт страница, компонент отвечает только за свой вид.
   *
   * Расписание идёт в разметке ПЕРВЫМ, а вправо его ставит явное размещение в
   * гриде. Так порядок чтения и порядок обхода клавиатурой совпадают с видимым на
   * узких ширинах, где блок стоит над описанием; вариант «описание первым, а блок
   * поднять `order: -1`» дал бы на телефоне видимый порядок один, а порядок
   * фокуса — обратный.
   *
   * `align-items` НЕ `start`, и причина узкая: липкая обёртка внутри колонки имеет
   * СВОЙ предел высоты с прокруткой, а при `start` колонка получает высоту своего
   * содержимого и уезжает вместе с ним. Общий примитив сайта живёт с
   * `align-items: start` и липнет исправно (`web/src/styles/layout.css:20-31`,
   * `.content-sidebar-aside--sticky`, потребитель — страница статьи) — первая
   * редакция этого комментария объявляла `start` сломанным вообще, и это неверно:
   * измерено на статье, сайдбар липнет, `top` 638 → 84 при `scrollY` 1800.
   *
   * Почему этот примитив здесь не переиспользован — названо, а не подразумевается:
   * у него перелом 900 px и отступ `+1.5rem`, а у утверждённого владельцем облика
   * этой страницы — 1024 px и `+1rem`, и колонка шире (21rem против 280 px у
   * статьи). Расхождение двух реализаций одного приёма записано в
   * `docs/tech-debt.md` (TD-44), чтобы его свели отдельной работой, а не забыли.
   */
  .seminar-cols {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 21rem;
    gap: 2.5rem;
    align-items: stretch;
  }

  .seminar-main {
    grid-column: 1;
    grid-row: 1;
    min-width: 0;
  }

  .seminar-cols > :global(.seminar-schedule) {
    grid-column: 2;
    grid-row: 1;
    /* Как и у левой колонки: без `min-width: 0` автоминимум грид-элемента равен
       min-content его содержимого, и любая неразрывная строка внутри распирает
       колонку шире дорожки. Ловится это только при увеличенном кегле. */
    min-width: 0;
  }

  /* Ниже 1024 колонки нет: блок расписания идёт во всю ширину над описанием.
     Явное размещение снимается, элементы встают в порядке разметки. */
  @media (max-width: 1024px) {
    .seminar-cols {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .seminar-main,
    .seminar-cols > :global(.seminar-schedule) {
      grid-column: auto;
      grid-row: auto;
    }
  }
</style>
