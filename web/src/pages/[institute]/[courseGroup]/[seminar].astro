---
import { seminarTitleFallback, seminarDescriptionFallback } from '../../../lib/seo-fallback';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import SeminarSchedulePanel from '../../../components/seminars/SeminarSchedulePanel.astro';
import {
  getInstitutes,
  getCourseGroups,
  getSeminars,
  getScheduleEntries,
  getTeachers,
  cleanBodyHtml,
  stripLegacySeminarTail,
} from '../../../lib/data';
import type { CourseGroup, Institute, Seminar } from '../../../lib/data';
import RichContent from '../../../components/RichContent.astro';
import { calendarToday, isCurrentOrFuture } from '../../../lib/schedule-window';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths: GetStaticPaths = () => {
  const institutes = getInstitutes();
  const allCGs = getCourseGroups();
  const allSeminars = getSeminars();
  const paths: { params: Record<string, string>; props: Record<string, unknown> }[] = [];

  for (const sem of allSeminars) {
    const cg = allCGs.find((c) => c.legacy_id === sem.course_group_legacy_id);
    if (!cg) continue;
    const inst = institutes.find((i) => i.slug === cg.institute_legacy_id);
    if (!inst) continue;
    paths.push({
      params: { institute: inst.slug, courseGroup: cg.slug, seminar: sem.slug },
      props: { seminar: sem, courseGroup: cg, institute: inst },
    });
  }
  return paths;
};

const { seminar, courseGroup, institute } = Astro.props as {
  seminar: Seminar;
  courseGroup: CourseGroup;
  institute: Institute;
};

// Актуальность считается по ПОСЛЕДНЕМУ дню события, а не по первому: из 63
// записей расписания 60 многодневные, и фильтр по startAt убирал бы идущий
// семинар со страницы уже на второй день обучения.
const today = calendarToday();
const schedule = getScheduleEntries().filter(
  (e) => e.seminar?.slug === seminar.slug && e.status === 'active' && isCurrentOrFuture(e, today)
);
const sortedSchedule = [...schedule].sort(
  (a, b) => new Date(a.startAt).getTime() - new Date(b.startAt).getTime()
);
const allTeachers = getTeachers();
const seminarUrl = `https://ikpk.su/${institute.slug}/${courseGroup.slug}/${seminar.slug}`;
const scheduleRows = sortedSchedule.map((entry) => ({
  entry,
  teachers: (entry.teachers || []).map((teacher) => {
    const full = allTeachers.find(
      (candidate) =>
        candidate.slug === String(teacher.id) ||
        candidate.legacy_id === String(teacher.id) ||
        candidate.name === teacher.fullName
    );

    return {
      fullName: teacher.fullName,
      href: `/${full?.institute_legacy_id || institute.slug}/prepodavatel/${full?.slug || teacher.id}`,
    };
  }),
}));
const seminarBodyHtml = seminar.description_html
  ? cleanBodyHtml(stripLegacySeminarTail(seminar.description_html), Astro.url.pathname)
  : '';

// Описание для схемы: у части семинаров нет ни seo-описания, ни секций (живой
// API отдаёт их пустыми — таких 5 из 126). Пустое description ломает разметку
// Course, поэтому цепочка отступлений заканчивается осмысленным текстом,
// собранным из имеющихся фактов, а не заглушкой «нет описания».
// Заголовок и описание страницы. У 11 семинаров, появившихся при обновлении
// каталога, seo-полей нет в природе: живой сайт собирает их шаблоном на месте.
// Подстановка пустого значения оставляла страницу без <title> — это и потеря
// сниппета в поиске, и нарушение доступности (axe: document-title).
const pageTitle =
  seminar.seo_title?.trim() ||
  seminarTitleFallback(seminar.name, institute.slug, institute.name);
const pageDescription =
  seminar.seo_description?.trim() ||
  seminarDescriptionFallback(seminar.name, courseGroup.name, institute.slug, institute.name);

const schemaDescription =
  seminar.seo_description?.trim() ||
  seminar.description_text?.slice(0, 200) ||
  pageDescription;

// Event без startDate невалиден (Google Rich Results) — Этап 3, план 004.
// Семинар с назначенной датой → Event; без даты → Course (программа обучения).
const seminarSchema =
  schedule.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'Event',
        name: seminar.name,
        description: schemaDescription,
        url: seminarUrl,
        organizer: {
          '@type': 'EducationalOrganization',
          name: 'ИКПК',
          url: 'https://ikpk.su',
        },
        location: {
          '@type': 'Place',
          name: 'ИКПК',
          address: {
            '@type': 'PostalAddress',
            addressLocality: 'Санкт-Петербург',
            addressCountry: 'RU',
          },
        },
        startDate: schedule[0].startAt,
        endDate: schedule[0].endAt,
        eventStatus: 'https://schema.org/EventScheduled',
        eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
        offers: {
          '@type': 'Offer',
          url: seminarUrl,
          price: schedule[0].isFree ? '0' : String(schedule[0].newPrice),
          priceCurrency: 'RUB',
          availability: 'https://schema.org/InStock',
        },
      }
    : {
        '@context': 'https://schema.org',
        '@type': 'Course',
        name: seminar.name,
        description: schemaDescription,
        url: seminarUrl,
        provider: {
          '@type': 'EducationalOrganization',
          name: 'ИКПК',
          url: 'https://ikpk.su',
        },
      };
---

<BaseLayout title={pageTitle} description={pageDescription} schema={seminarSchema}>
  <div class="container">
    <Breadcrumbs
      items={[
        { label: institute.name, href: `/${institute.slug}` },
        { label: courseGroup.name, href: `/${institute.slug}/${courseGroup.slug}` },
        { label: seminar.name },
      ]}
    />

    <article class="section seminar-detail">
      <h1 class="page-title">{seminar.name}</h1>

      <div class="seminar-cols">
        <SeminarSchedulePanel rows={scheduleRows} />

        <div class="seminar-main">
          {seminarBodyHtml ? (
            <div class="seminar-content rich-content">
              <RichContent html={seminarBodyHtml} sinkId="seminar-body" />
            </div>
          ) : seminar.description_text && (
            <div class="seminar-content rich-content">
              <p>{seminar.description_text}</p>
            </div>
          )}
        </div>
      </div>
    </article>
  </div>
</BaseLayout>

<style>
  .page-title {
    margin: 0 0 1.75rem;
    font-size: clamp(2rem, 1.65rem + 1.2vw, 3rem);
    line-height: 1.12;
  }

  .seminar-content {
    margin-bottom: 0;
    line-height: 1.75;
  }

  /*
   * Расписание — в боковой колонке справа, описание слева (вариант C, выбор
   * владельца 23.08.2026). Раскладка живёт здесь, а не в компоненте: место блока
   * на странице задаёт страница, компонент отвечает только за свой вид.
   *
   * Расписание идёт в разметке ПЕРВЫМ, а вправо его ставит явное размещение в
   * гриде. Так порядок чтения и порядок обхода клавиатурой совпадают с видимым на
   * узких ширинах, где блок стоит над описанием; вариант «описание первым, а блок
   * поднять `order: -1`» дал бы на телефоне видимый порядок один, а порядок
   * фокуса — обратный.
   *
   * `align-items` НЕ `start`: при `start` колонка расписания получает высоту своего
   * содержимого, и `position: sticky` внутри неё уезжает вместе с ней после первого
   * экрана. Растянутая колонка даёт липкости полный ход.
   */
  .seminar-cols {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 21rem;
    gap: 2.5rem;
    align-items: stretch;
  }

  .seminar-main {
    grid-column: 1;
    grid-row: 1;
    min-width: 0;
  }

  .seminar-cols > :global(.seminar-schedule) {
    grid-column: 2;
    grid-row: 1;
  }

  /* Ниже 1024 колонки нет: блок расписания идёт во всю ширину над описанием.
     Явное размещение снимается, элементы встают в порядке разметки. */
  @media (max-width: 1024px) {
    .seminar-cols {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .seminar-main,
    .seminar-cols > :global(.seminar-schedule) {
      grid-column: auto;
      grid-row: auto;
    }
  }
</style>
