---
/**
 * Прототип страницы семинара с датой (§7.6) — эталон для сравнения шапок.
 * Ветка без дат — отдельно: /preview/<id>/seminar-undated
 */
import type { GetStaticPaths } from 'astro';
import TopNavLayout from '../../../layouts/TopNavLayout.astro';
import SeminarArchitectureHeader from '../../../components/seminars/SeminarArchitectureHeader.astro';
import RichContent from '../../../components/RichContent.astro';
import {
  getInstitutes,
  getCourseGroups,
  getSeminars,
  getScheduleEntries,
  getTeachers,
  cleanBodyHtml,
  stripLegacySeminarTail,
  formatPrice, getSnapshotReferenceDate,
} from '../../../lib/data';
import { isCurrentOrFuture } from '../../../lib/schedule-window';
import { registrationHref, isDemoForms } from '../../../lib/forms';
import {
  formatScheduleDateRange,
  findTeacherForScheduleLead,
} from '../../../lib/home';
import { ARCHITECTURE_IDS, variants, type ArchitectureId } from '../../../lib/variants';

export const getStaticPaths: GetStaticPaths = () =>
  isDemoForms
    ? ARCHITECTURE_IDS.map((variant) => ({ params: { variant } }))
    : [];

const { variant: variantId } = Astro.params;
const architecture = variantId as ArchitectureId;
const variant = variants[architecture]!;

const institutes = getInstitutes();
const allCGs = getCourseGroups();
const allSeminars = getSeminars();
const allTeachers = getTeachers();
const today = getSnapshotReferenceDate();

// Эталон с датой и преподавателем — один для всех трёх.
const entry = getScheduleEntries()
  .filter((e) => e.status === 'active' && e.startAt && isCurrentOrFuture(e, today) && e.teachers?.length)
  .sort((a, b) => a.startAt.localeCompare(b.startAt))[0];

const seminar = allSeminars.find((s) => s.slug === entry?.seminar.slug) || allSeminars[0];
const courseGroup = allCGs.find((c) => c.legacy_id === seminar.course_group_legacy_id)!;
const institute = institutes.find((i) => i.slug === courseGroup.institute_legacy_id)!;

const scheduleRaw = getScheduleEntries().filter(
  (e) => e.seminar?.slug === seminar.slug && e.status === 'active' && isCurrentOrFuture(e, today)
);
const sorted = [...scheduleRaw].sort(
  (a, b) => new Date(a.startAt).getTime() - new Date(b.startAt).getTime()
);

// В шапке нужна ближайшая дата; остальной список не передаём.
const nearest = sorted[0];
const schedule = nearest
  ? (() => {
      const lead = nearest.teachers?.[0];
      const full = findTeacherForScheduleLead(lead, allTeachers);
      return [
        {
          dateLabel: formatScheduleDateRange(nearest.startAt, nearest.endAt),
          cityName: nearest.city?.name || 'Уточняется',
          priceLabel: nearest.isFree ? 'Бесплатно' : formatPrice(nearest.newPrice),
          durationLabel: nearest.duration ? `${nearest.duration} ч` : '',
          formHref: registrationHref(nearest.registrationFormLink) || '/raspisanie-i-tseny',
          teacher: lead
            ? {
                name: lead.fullName.split(',')[0].trim(),
                photo: full?.photo || null,
                href: full
                  ? `/${full.institute_legacy_id}/prepodavatel/${full.slug}`
                  : null,
              }
            : undefined,
        },
      ];
    })()
  : [];

const code = seminar.name.match(/^[А-ЯA-Z]+-\d+/i)?.[0] || '';
const bodyHtml = seminar.description_html
  ? cleanBodyHtml(stripLegacySeminarTail(seminar.description_html), Astro.url.pathname)
  : '';
---
<TopNavLayout
  title={`${seminar.name} — прототип ${variant.label}`}
  description={seminar.seo_description || variant.description}
  noindex={true}
>
  <div class="preview-ribbon">
    Семинар · {variant.label} ·
    <a href={`/preview/${architecture}`}>главная каркаса</a> ·
    <a href={`/preview/${architecture}/seminar-undated`}>без дат</a> ·
    <a href={`/preview/${architecture}/schedule`}>расписание</a> ·
    <a href="/preview/hub">все каркасы</a>
  </div>

  <SeminarArchitectureHeader
    architecture={architecture}
    seminar={seminar}
    courseGroup={courseGroup}
    institute={institute}
    code={code}
    schedule={schedule}
    bodyHtml={architecture === 'modular' ? bodyHtml : undefined}
  />

  {architecture !== 'modular' && (
    <div class="sem-body container">
      {bodyHtml ? (
        <div class="rich-content">
          <RichContent html={bodyHtml} sinkId="preview-seminar-body" />
        </div>
      ) : (
        <p class="sem-empty">Описание семинара в данных отсутствует.</p>
      )}
    </div>
  )}

  <aside class="provenance-legend" data-provenance-legend>
    <strong>Происхождение изображений</strong>
    <ul>
      <li><span class="pv pv-authentic"></span> подлинное фото ИКПК — портреты</li>
      <li><span class="pv pv-stock"></span> сток / CGI</li>
      <li><span class="pv pv-brand"></span> знак бренда</li>
    </ul>
  </aside>

  <script is:inline>
    (function () {
      const brand = /logo|emblem|icon|\/media\/legacy\//i;
      const portrait = /\/media\/users\/\d+\/images\//;
      document.querySelectorAll('img[src^="/media"], img[src*="/media/_w/"]').forEach(function (img) {
        const src = img.getAttribute('src') || '';
        let kind = brand.test(src) ? 'brand' : portrait.test(src) ? 'authentic' : 'stock';
        const inTeacher = img.closest('[class*="teacher"], .sem-fa-figure, .sem-mo-teacher') !== null;
        if (kind === 'authentic' && !inTeacher) kind = 'stock';
        img.setAttribute('data-provenance', kind);
      });
    })();
  </script>
</TopNavLayout>

<style>
  .preview-ribbon {
    background: #1a1a1a; color: #fff; text-align: center;
    font-size: 0.8rem; padding: 0.4rem 1rem;
  }
  .preview-ribbon a {
    color: #abd6ac;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .sem-body { padding: 2.5rem 1.25rem 4rem; max-width: 44rem; }
  .sem-empty { color: var(--text-muted); }
  .provenance-legend {
    position: sticky; bottom: 0; z-index: 20;
    background: var(--surface-inverse); color: var(--text-inverse);
    padding: 0.75rem 1rem; font-size: var(--font-xs);
  }
  .provenance-legend ul {
    display: flex; flex-wrap: wrap; gap: 1rem; list-style: none; margin: 0.35rem 0 0; padding: 0;
  }
  .pv { width: 0.9rem; height: 0.9rem; border-radius: 2px; display: inline-block; }
  .pv-authentic { background: #4d9450; }
  .pv-stock { background: #c46a1f; }
  .pv-brand { background: #6b7280; }
  :global(img[data-provenance='stock']) { outline: 3px solid #c46a1f; outline-offset: -3px; }
  :global(img[data-provenance='authentic']) { outline: 3px solid #4d9450; outline-offset: -3px; }
  :global(img[data-provenance='brand']) { outline: 2px dashed #6b7280; outline-offset: -2px; }
</style>
