---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { excerpt, getCourseGroups } from '../../lib/data';

const programs = [...getCourseGroups()].sort((a, b) => (a.order ?? Infinity) - (b.order ?? Infinity));

const title = 'Программы — ИКПК';
const description = 'Программы обучения ИКПК по всем институтам.';
---

<BaseLayout title={title} description={description}>
  <div class="container">
    <Breadcrumbs items={[{ label: 'Программы' }]} />

    <section class="section">
      <h1 class="page-title">Программы</h1>

      {programs.length > 0 ? (
        <div class="grid grid-3">
          {programs.map((program) => (
            <a href={`/programmy/${program.slug}`} class="card">
              <div class="card-body">
                <h2 class="catalog-card-title">{program.name}</h2>
                <p class="text-muted">{excerpt(program.description_text, 160)}</p>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <p class="text-muted">Программы пока не добавлены.</p>
      )}
    </section>
  </div>
</BaseLayout>

<style>
  .page-title {
    margin-bottom: 1rem;
  }

  .catalog-card-title {
    font-size: var(--font-m);
    font-weight: 600;
    color: var(--color-dark-700);
    margin: 0 0 0.4rem;
  }

  a.card {
    display: block;
    text-decoration: none;
    color: inherit;
  }
</style>
