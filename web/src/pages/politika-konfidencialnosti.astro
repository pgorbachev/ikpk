// править юридический текст без согласования. Новые пункты помечены явно: 1.1.4, 1.4, 2.2.2,
// 3.3.5.
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

