---
import SchedulePage from '../components/schedule/SchedulePage.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { formatDurationDisplay, formatPrice, getInstitutes, getPage, getScheduleEntries, getSeminarBuildNow, getTeachers, resolveTeacherReference, teacherPageHref } from '../lib/data';
import { calendarDay, isBeforeStart } from '../lib/schedule-window';
import { monthKeys, monthOptions } from '../lib/schedule-months';
import { occurrenceRegistrationHref } from '../lib/forms';
import { publicScheduleTitle } from '../lib/schedule-public-title';

const page = getPage('raspisanie-i-tseny');
const institutes = getInstitutes();
const teachers = getTeachers();

const title = page?.seo_title || 'Расписание и цены — ИКПК';
const description = page?.seo_description || 'Расписание семинаров и цены на обучение в ИКПК.';

function slugify(value: string): string {
  return value
    .toLowerCase()
    .replace(/ё/g, 'е')
    .replace(/[^a-zа-я0-9]+/gi, '-')
    .replace(/^-+|-+$/g, '');
}

const todayDate = getSeminarBuildNow();
const todayCalendarDay = calendarDay(todayDate.toISOString());
const entries = getScheduleEntries()
  // Build-time offers use the current clock; the browser advances this boundary.
  .filter((entry) => entry.status === 'active' && isBeforeStart(entry, todayDate))
  .sort((a, b) => calendarDay(a.startAt).localeCompare(calendarDay(b.startAt)));

const instituteByName = new Map(institutes.map((institute) => [institute.name, institute]));
const instituteOptionOrder = new Map(institutes.map((institute, index) => [institute.slug, index]));
const visibleInstitutes = entries
  .map((entry) => {
    const institute = instituteByName.get(entry.institute.name);
    return institute ? { label: institute.name, value: institute.slug } : null;
  })
  .filter((value): value is { label: string; value: string } => Boolean(value))
  .filter((value, index, values) => values.findIndex((candidate) => candidate.value === value.value) === index)
  .sort((a, b) => (instituteOptionOrder.get(a.value) ?? 999) - (instituteOptionOrder.get(b.value) ?? 999));

const visibleCities = entries
  .map((entry) => entry.city?.name || '')
  .filter(Boolean)
  .filter((value, index, values) => values.indexOf(value) === index)
  .sort((a, b) => a.localeCompare(b, 'ru'));

// Месяцы выводятся из ТЕХ ЖЕ записей, что и карточки, и после фильтра окна
// актуальности: список получается объединением уже отсечённых ключей, поэтому месяца
// без записей в нём быть не может, а ключа без месяца — тоже. Опорная дата — уже
// вычисленный `todayDate`; второй вычислитель «сегодня» здесь не заводится.
const visibleMonths = monthOptions(entries, todayCalendarDay);

const visiblePrograms = entries
  .map((entry) => {
    const institute = instituteByName.get(entry.institute.name);
    return {
      instituteSlug: institute?.slug || '',
      name: entry.program.name,
      slug: entry.program.slug,
    };
  })
  .filter((value, index, values) => values.findIndex((candidate) => candidate.slug === value.slug) === index)
  .sort((a, b) => a.name.localeCompare(b.name, 'ru'));

const items = entries.map((entry) => {
  const institute = instituteByName.get(entry.institute.name);
  const teacher = entry.teachers?.[0]
    ? resolveTeacherReference(entry.teachers[0], teachers)
    : undefined;
  const teacherName = entry.teachers?.[0]?.fullName || 'Преподаватель уточняется';
  const instituteSlug = institute?.slug || slugify(entry.institute.shortname || entry.institute.name);
  const teacherHref = teacherPageHref(teacher);
  const seminarHref = institute
    ? `/${institute.slug}/${entry.program.slug}/${entry.seminar.slug}`
    : '/raspisanie-i-tseny';
  const eventTitle = publicScheduleTitle(entry);
  const searchIndex = [
    eventTitle,
    teacherName,
    entry.institute.name,
    entry.program.name,
    entry.city?.name || '',
    entry.additionalText || '',
  ].join(' ').toLowerCase();

  return {
    startAt: entry.startAt,
    additionalText: entry.additionalText || '',
    cityName: entry.city?.name || 'Уточняется',
    citySlug: slugify(entry.city?.name || 'unknown'),
    dateLabel: formatDurationDisplay(entry.duration, { mode: 'schedule-row', startAt: entry.startAt, endAt: entry.endAt }),
    id: entry.id,
    imageAlt: `Изображение для события «${eventTitle}»`,
    imageUrl: entry.image?.url || '',
    instituteName: entry.institute.name,
    instituteSlug,
    months: monthKeys(entry, todayCalendarDay),
    priceLabel: entry.isFree === true ? 'Бесплатно' : formatPrice(entry.newPrice),
    programName: entry.program.name,
    programSlug: entry.program.slug,
    registrationHref: occurrenceRegistrationHref(entry.registrationFormLink),
    searchIndex,
    teacherHref,
    teacherLabel: entry.institute.shortname === 'ИКПК' ? 'Преподаватель:' : 'Автор:',
    teacherName,
    title: eventTitle,
    titleHref: seminarHref,
  };
});
---

<BaseLayout title={title} description={description} newsletterVariant="none">
  <div class="container schedule-page">
    <Breadcrumbs items={[{ label: 'Расписание и цены' }]} />
    <SchedulePage title="Расписание и цены" institutes={visibleInstitutes} programs={visiblePrograms} cities={visibleCities} months={visibleMonths} items={items} />
  </div>
</BaseLayout>
