# Объявленное состояние окружения «stand» (change server-provisioning).
#
# Значения здесь НЕ секретны — сами секреты сюда не попадают, только их ИМЕНА
# (design.md, Решение 3). Читается `scripts/bootstrap-vps.sh` и
# `scripts/verify-server-state.sh`; формат — `KEY=значение`, список через запятую.

SITE_NAME=ikpk
WEB_ROOT=/var/www/ikpk

# --- Инвентарь ПО (Requirement «Объявленное состояние включает инвентарь…») ---
DISTRO=debian-13
PACKAGES=nginx,rsync,python3
PACKAGE_VERSION_RULE=latest-in-distro-repos

# --- Размещение данных системы управления ---
CMS_DB_CLIENT=postgres
CMS_DATA_DIR=/var/lib/ikpk-cms/prod/data
BACKUP_INCLUDES=/var/lib/ikpk-cms/prod/data,/var/www/ikpk/current

# --- Служба системы управления (объём 5b.1 — годится любая программа на этом адресе) ---
SERVICE_ACCOUNT=ikpk-cms
SERVICE_ADDR=127.0.0.1:1337
# Команда запуска: юнит без ExecStart systemd отвергает. См. stand.env.
SERVICE_EXEC_START=/usr/bin/node node_modules/@strapi/strapi/bin/strapi.js start
SERVICE_PROXY_PATH=/admin
SERVICE_UNIT=/etc/systemd/system/ikpk-cms.service
SERVICE_PROXY_SNIPPET=/etc/nginx/snippets/ikpk-cms-prod.conf
CMS_ARTIFACT_SOURCE=
CMS_ARTIFACT_DIR=/opt/ikpk-cms
LISTEN_ALLOWLIST=0.0.0.0:80,[::]:80,127.0.0.1:1337
NETWORK_CLOSEDNESS_PROPERTY=SERVICE_ADDR_LOOPBACK

# --- Политики обращения с посторонним (Requirement «Состояние, созданное вне…») ---
POLICY_VHOST=merge
# Посторонние включения, которые провижининг ОБЯЗАН сохранить при политике merge.
# Снято с живого vhost стенда: помимо блоков certbot там подключён снипет платёжной
# службы. Без пометки merge вынес бы его, и форма оплаты на стенде перестала бы
# работать — регресс на клиентской машине из-за молчаливого пропуска в перечне.
VHOST_FOREIGN_MARKERS="managed by Certbot,ikpk-payments-prod.conf"

# --- Секреты (Requirement «Секреты не хранятся в репозитории…») ---
# Обязательные секреты. Перечень — не «один для примера», а ВСЕ, без которых Strapi не
# поднимается: он проверяет их на старте и падает. Прежний перечень из одного имени
# прошёл бы проверку провижининга и упёрся бы в отказ службы уже на healthcheck.
SECRET_NAMES=APP_KEYS,API_TOKEN_SALT,ADMIN_JWT_SECRET,TRANSFER_TOKEN_SALT,JWT_SECRET,ENCRYPTION_KEY
SECRET_TRANSPORT=process-env
SECRET_FILE=/etc/ikpk-cms/prod.env
SECRET_OWNER=ikpk-cms
SECRET_MODE=600

# --- Резервные копии (Requirement «Резервная копия предшествует…») ---
# BACKUP_DIR — копии vhost, по умолчанию РЯДОМ с самим vhost (существующее поведение
# scripts/bootstrap-vps.sh:66 распространено на объявленное состояние, а не заменено).
BACKUP_DIR=/etc/nginx/sites-available
CONTENT_BACKUP_DIR=/var/backups/ikpk/current
RESTORE_CMD="bash /repo/scripts/restore-server-state.sh prod"

# --- Ревизия объявленного состояния (Requirement «Провижининг идемпотентен…») ---
PROVISION_REVISION=1

# --- Непрерывность раздачи ---
CONTINUITY_POLL_INTERVAL_MS=50

# --- Модель объявленных свойств (Requirement «…проверяет достигнутое состояние по покрытию») ---
PROPERTY_RELEASES_DIR_CLASS=auto
PROPERTY_SHARED_DIR_CLASS=auto
PROPERTY_VHOST_ENABLED_CLASS=auto
PROPERTY_VHOST_INCLUDE_CLASS=auto
PROPERTY_VHOST_GZIP_CLASS=auto
PROPERTY_REDIRECTS_FILE_CLASS=auto
PROPERTY_NGINX_RUNNING_CLASS=auto
PROPERTY_DEFAULT_SITE_DISABLED_CLASS=auto
PROPERTY_REVISION_RECORDED_CLASS=auto
PROPERTY_PACKAGES_INSTALLED_CLASS=auto
PROPERTY_CMS_DATA_DIR_CLASS=auto
PROPERTY_SERVICE_ACCOUNT_CLASS=auto
PROPERTY_SERVICE_UNIT_CLASS=auto
PROPERTY_SERVICE_ADDR_LOOPBACK_CLASS=auto
PROPERTY_SERVICE_PROXY_CLASS=auto

# Два исключения из tasks.md, раздел 0 — ручная приёмка, а не автоматическая проверка.
PROPERTY_TLS_SURVIVES_CLASS=manual
PROPERTY_TLS_SURVIVES_EVIDENCE=1:docs/evidence/tls-survives.md
PROPERTY_BACKUP_VOLUME_CLASS=manual
PROPERTY_BACKUP_VOLUME_EVIDENCE=1:docs/evidence/backup-volume.md
