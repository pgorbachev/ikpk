# Объявленное состояние ВРЕМЕННОЙ пробной машины (89.111.143.219, Ubuntu 26.04).
# Не production: машина может быть пересоздана, данные тестовые, DNS не меняется.
# Порядок работ и что теряется при пересоздании — docs/runbook-trial-vps.md.
# Секреты сюда не попадают, только их имена.

SITE_NAME=ikpk
WEB_ROOT=/var/www/ikpk

# Дерево кнопки «Обновить сайт» (как на стенде). Проверка релиза идёт по loopback HTTP.
SITE_BUILD_WORKSPACE=/var/lib/ikpk-site-build
SITE_DEMO_FORMS=stub
# Оплата выключена: формы оплаты нет, запросов к платёжному API нет (контракт роли `ci`).
SITE_PAYMENT_ROLE=ci
SITE_VERIFY_URL=http://127.0.0.1/release.json
SITE_VERIFY_HOST=89.111.143.219
SITE_MEDIA_CACHE=/var/www/ikpk/current/media

# Node и npm — из штатного репозитория Ubuntu 26.04 (nodejs 22.x, в диапазоне cms engines).
# sqlite3 — для онлайн-копии базы; restic — резервная копия; python3-venv — certbot для IP.
DISTRO=ubuntu-26.04
PACKAGES=nginx,rsync,python3,python3-venv,make,g++,nodejs,npm,sqlite3,restic,curl
PACKAGE_VERSION_RULE=latest-in-distro-repos

# Пробная гипотеза: SQLite на диске VPS. PostgreSQL в CMS не подключён (нет драйвера pg).
CMS_DB_CLIENT=sqlite
CMS_DATA_DIR=/var/lib/ikpk-cms/trial/data
BACKUP_INCLUDES=/var/lib/ikpk-cms/trial/data,/opt/ikpk-cms/shared/uploads,/var/www/ikpk/current

SERVICE_ACCOUNT=ikpk-cms
SERVICE_ADDR=127.0.0.1:1337
SERVICE_EXEC_START=/usr/bin/node node_modules/@strapi/strapi/bin/strapi.js start
# 1 ГБ + временный swap: срок взят со стенда того же класса и на пробе ИЗМЕРЯЕТСЯ заново.
SERVICE_HEALTH_TIMEOUT=1800
SERVICE_PROXY_PATH=/admin
# Панель Strapi ходит не только в /admin. Один префикс даёт HTML и 404 на API.
SERVICE_PROXY_PREFIXES=/admin,/content-manager,/upload,/i18n
SERVICE_UNIT=/etc/systemd/system/ikpk-cms.service
# Админка снаружи без туннеля: nginx :80 проксирует префиксы на 127.0.0.1:1337.
# HTTP — пароль открытым текстом; для пробы по IP принято, для production нет.
SERVICE_PROXY_SNIPPET=/etc/nginx/snippets/ikpk-cms-trial.conf
SERVICE_PROXY_SNIPPET_TARGET=/etc/nginx/snippets/ikpk-cms-trial.conf
CMS_ARTIFACT_SOURCE=
CMS_ARTIFACT_DIR=/opt/ikpk-cms
LISTEN_ALLOWLIST=0.0.0.0:80,[::]:80,0.0.0.0:443,[::]:443,127.0.0.1:1337
NETWORK_CLOSEDNESS_PROPERTY=SERVICE_ADDR_LOOPBACK

POLICY_VHOST=merge
VHOST_FOREIGN_MARKERS="managed by Certbot"

# Провижининг переписывает файл секретов ровно из этого перечня, поэтому учётка
# администратора контента входит в него — иначе повторный прогон её стёр бы.
SECRET_NAMES=APP_KEYS,API_TOKEN_SALT,ADMIN_JWT_SECRET,TRANSFER_TOKEN_SALT,JWT_SECRET,ENCRYPTION_KEY,CONTENT_ADMIN_EMAIL,CONTENT_ADMIN_PASSWORD
SECRET_TRANSPORT=process-env
SECRET_FILE=/etc/ikpk-cms/trial.env
SECRET_OWNER=ikpk-cms
SECRET_MODE=600

BACKUP_DIR=/etc/nginx/sites-available
CONTENT_BACKUP_DIR=/var/backups/ikpk/current
RESTORE_CMD="bash /repo/scripts/restore-server-state.sh trial"

PROVISION_REVISION=1
CONTINUITY_POLL_INTERVAL_MS=50

PROPERTY_RELEASES_DIR_CLASS=auto
PROPERTY_SHARED_DIR_CLASS=auto
PROPERTY_VHOST_ENABLED_CLASS=auto
PROPERTY_VHOST_INCLUDE_CLASS=auto
PROPERTY_VHOST_GZIP_CLASS=auto
PROPERTY_REDIRECTS_FILE_CLASS=auto
PROPERTY_NGINX_RUNNING_CLASS=auto
PROPERTY_DEFAULT_SITE_DISABLED_CLASS=auto
PROPERTY_REVISION_RECORDED_CLASS=auto
PROPERTY_PACKAGES_INSTALLED_CLASS=auto
PROPERTY_CMS_DATA_DIR_CLASS=auto
PROPERTY_SERVICE_ACCOUNT_CLASS=auto
PROPERTY_SERVICE_UNIT_CLASS=auto
PROPERTY_SERVICE_ADDR_LOOPBACK_CLASS=auto
PROPERTY_SERVICE_PROXY_CLASS=auto
PROPERTY_TLS_SURVIVES_CLASS=manual
PROPERTY_TLS_SURVIVES_EVIDENCE=1:docs/evidence/tls-survives.md
PROPERTY_BACKUP_VOLUME_CLASS=manual
PROPERTY_BACKUP_VOLUME_EVIDENCE=1:docs/evidence/backup-volume.md
