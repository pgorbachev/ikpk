# Объявленное состояние окружения «stand» (change server-provisioning).
#
# Значения здесь НЕ секретны — сами секреты сюда не попадают, только их ИМЕНА
# (design.md, Решение 3). Читается `scripts/bootstrap-vps.sh` и
# `scripts/verify-server-state.sh`; формат — `KEY=значение`, список через запятую.

SITE_NAME=ikpk
WEB_ROOT=/var/www/ikpk

# --- Инвентарь ПО (Requirement «Объявленное состояние включает инвентарь…») ---
# DISTRO замерен по факту на живом стенде (не по образу тестовой цели — тот
# фиксирован design.md Решением 2 на debian:12-slim и с этим расходится сознательно):
# Debian GNU/Linux 13 (trixie). nginx 1.26.3 и node v22.23.2 уже стоят на стенде;
# node этот скрипт НЕ переустанавливает — инвентарь ниже его не перечисляет,
# переустановка рискует конфликтом с уже рабочей версией. Память стенда тесная
# (948 МБ, свободно 619 МБ на момент замера) — это учтено как факт, а не как
# входящее в объём этого change решение (swap и т.п. — вне объёма).
DISTRO=debian-13
# `make`/`g++` нужны не «на всякий случай»: драйвер базы системы управления
# (`better-sqlite3`) — нативный модуль, и без готовой сборки под эту связку node+платформа
# npm собирает его из исходников. Проверено на стенде: `npm ci` упал с
# «gyp ERR! stack Error: not found: make», служба не поднялась, артефакт откатился.
PACKAGES=nginx,rsync,python3,make,g++
PACKAGE_VERSION_RULE=latest-in-distro-repos

# --- Размещение данных системы управления ---
CMS_DB_CLIENT=sqlite
CMS_DATA_DIR=/var/lib/ikpk-cms/stand/data
BACKUP_INCLUDES=/var/lib/ikpk-cms/stand/data,/var/www/ikpk/current

# --- Служба системы управления (объём 5b.1 — годится любая программа на этом адресе) ---
SERVICE_ACCOUNT=ikpk-cms
SERVICE_ADDR=127.0.0.1:1337
# Команда запуска. Юнит без ExecStart systemd не принимает («Refusing»), поэтому объявление
# обязательно. Путь — точка входа Strapi из доставленного артефакта; node_modules приезжает
# симлинком из общего каталога.
SERVICE_EXEC_START=/usr/bin/node node_modules/@strapi/strapi/bin/strapi.js start
# Срок ожидания ответа службы после смены артефакта, секунды. Замерено на стенде
# трижды: 142 с на свободной машине, 370 с под памятью на пределе (948 МБ, своп в
# ходу) и БОЛЬШЕ 600 с в прогоне, где тот же провижининг перед сменой артефакта поставил
# зависимости (`npm ci`, 46 минут) — от Started в журнале до появления слушающего сокета.
# Прежние зашитые ~16 с и первая оценка в 240 с объявляли исправную службу мёртвой, и
# провижининг откатывался.
#
# Третий замер, 23.09.2026: служба нового релиза получила 7,3 с процессорного времени за
# десять минут — она не падала, а голодала. Срок 600 с истёк, и исправный релиз откатился на
# сентябрьский (`[bootstrap] служба системы управления не ответила на 127.0.0.1:1337`).
#
# Теснил её НЕ сам `npm ci`, а его последействие, и разница существенная. Установка идёт
# синхронно и ЗАВЕРШАЕТСЯ до смены артефакта (`scripts/bootstrap-vps.sh`: `npm ci` — до
# `systemctl restart`, а окно ожидания открывается уже после него; в приложенном логе
# `added 1366 packages … in 46m` стоит выше строки отката). То есть в шестисотсекундном окне
# конкурента уже не было: остались выбитый страничный кэш и заполненный своп. Отсюда важное
# следствие — ждать, что «машина освободится», не приходится: она уже свободна, медленна она
# по другой причине.
#
# ОТКУДА 1800, честно: ниоткуда. Замер даёт только нижнюю границу — «больше 600»: наблюдалось
# истечение срока, а не успешный старт. Прогон откатился, службу остановили, и сколько ей
# требовалось на самом деле, не знает никто. 1800 — прежнее число втрое, с запасом на глаз.
#
# Посчитать «сколько надо» по имеющимся числам НЕЛЬЗЯ, и попытка была: две редакции этого
# абзаца делили 142 с на замеренную долю процессорного и получали то «больше трёх часов», то
# «не больше трёх часов». Обе неверны в основании. 142 с — время НАСТЕННОЕ (замер «от Started
# в журнале до появления слушающего сокета», см. выше), а не процессорное; чтобы обратить его
# в процессорное, нужно число ядер этой машины, и его нет нигде в репозитории. Считать по
# величине, которой никто не мерил, — ровно тот дефект, который эта правка и исправляет в
# другом месте. Расчёт убран, а не поправлен: у него нет входных данных.
#
# Настенный срок здесь плохая мера в принципе — он измеряет не то, чем служба ограничена.
# Лечение — признак ПРОГРЕССА (растёт ли RSS, пишет ли служба в журнал, сколько получила
# процессорного), записан долгом TD-69. Свидетельства — `docs/evidence/stand-deploy-2026-09-23/`.
#
# ЦЕНА этого срока названа, а не отрицается. Ранний выход по `failed` в цикле ожидания есть
# (`scripts/bootstrap-vps.sh`, `служба признана упавшей за`), но ловит он только БЫСТРОЕ
# падение — неверный ExecStart, занятый порт, EACCES. Два случая он не ловит вовсе:
#
#   * при `Type=simple` служба, которая стартовала и слушающий сокет так и не открыла, в
#     `failed` не переходит по построению: systemd считает её запущенной с момента fork;
#   * при `StartLimitIntervalSec=120`, `StartLimitBurst=5` и `RestartSec=3` до `failed` нужно
#     пять стартов в двухминутном окне. Пять стартов — это ЧЕТЫРЕ промежутка, то есть
#     4 × (жизнь + 3) ≤ 120, откуда попытка короче ~27 с. (Прежняя редакция писала ~21 с,
#     деля на пять промежутков вместо четырёх; на вывод это не влияло, но число выводилось не
#     из названной посылки.) Замеренный старт Strapi здесь — 142 с на свободной машине; релиз,
#     падающий на 60-й секунде загрузки, перезапускается раз в ~63 с, в окно попадает не
#     больше двух стартов, и `failed` не наступает никогда.
#
# То есть сломанный МЕДЛЕННО релиз теперь держит оператора 30 минут вместо 10. Это принятый
# размен: голодающая исправная служба ничем не отличима от медленно сломанной, пока одна из
# них не ответит, а откат исправного релиза дороже получаса ожидания. Заявлять, будто
# удлинение срока сломанную службу не затрагивает, было бы неверно — первая редакция этой
# записи так и заявляла.
SERVICE_HEALTH_TIMEOUT=1800
SERVICE_PROXY_PATH=/admin
SERVICE_UNIT=/etc/systemd/system/ikpk-cms.service
# ВРЕМЕННО ПУСТО: публичное проксирование админки отключено намеренно.
# Установка владельца: система управления не должна быть доступна заказчику, пока журнал
# происхождения не наполнен, — иначе нормальное состояние неотличимо от отката. Журнал
# заведён (ветка state/cms-provenance), но ПУСТ: ledger/ содержит только .gitkeep,
# verified-pairs.json равен []. То есть цель ограничения не достигнута.
# Доступ к админке на это время — ssh-туннель на SERVICE_ADDR, механизм проверен.
# Снять пустоту, когда в журнале появятся записи о правках (TD-56).
SERVICE_PROXY_SNIPPET=
SERVICE_PROXY_SNIPPET_TARGET=/etc/nginx/snippets/ikpk-cms-stand.conf
# Доставка собранного артефакта (Requirement, tasks.md 5b.2a): CMS_ARTIFACT_SOURCE —
# ЛОКАЛЬНЫЙ каталог с готовой сборкой; пусто — сборки ещё нет, шаг пропускается (не
# наблюдалось в природе). CMS_ARTIFACT_DIR — releases/current на сервере, тем же
# приёмом, что и WEB_ROOT.
# Источник артефакта — ЛОКАЛЬНЫЙ каталог, собранный через scripts/build-cms-artifact.sh
# (dist + package*.json + tsconfig.json + database/ + public). Собранный иначе каталог
# выкатка отвергнет: без database/ миграции не выполнятся и значения будут потеряны.
# Пусто = сборки нет, шаг пропускается. Значение задаётся на запуск, а не хранится здесь:
# путь принадлежит машине оператора, а не объявленному состоянию сервера.
CMS_ARTIFACT_SOURCE=
CMS_ARTIFACT_DIR=/opt/ikpk-cms
LISTEN_ALLOWLIST=0.0.0.0:80,[::]:80,127.0.0.1:1337
NETWORK_CLOSEDNESS_PROPERTY=SERVICE_ADDR_LOOPBACK

# --- Политики обращения с посторонним (Requirement «Состояние, созданное вне…») ---
POLICY_VHOST=merge
# Посторонние включения, которые провижининг ОБЯЗАН сохранить при политике merge.
# Снято с живого vhost стенда: помимо блоков certbot там подключён снипет платёжной
# службы. Без пометки merge вынес бы его, и форма оплаты на стенде перестала бы
# работать — регресс на клиентской машине из-за молчаливого пропуска в перечне.
VHOST_FOREIGN_MARKERS="managed by Certbot,ikpk-payments-stand.conf"

# --- Секреты (Requirement «Секреты не хранятся в репозитории…») ---
# Обязательные секреты. Перечень — не «один для примера», а ВСЕ, без которых Strapi не
# поднимается: он проверяет их на старте и падает. Прежний перечень из одного имени
# прошёл бы проверку провижининга и упёрся бы в отказ службы уже на healthcheck.
SECRET_NAMES=APP_KEYS,API_TOKEN_SALT,ADMIN_JWT_SECRET,TRANSFER_TOKEN_SALT,JWT_SECRET,ENCRYPTION_KEY
SECRET_TRANSPORT=process-env
SECRET_FILE=/etc/ikpk-cms/stand.env
SECRET_OWNER=ikpk-cms
SECRET_MODE=600

# --- Резервные копии (Requirement «Резервная копия предшествует…») ---
# BACKUP_DIR — копии vhost, по умолчанию РЯДОМ с самим vhost (существующее поведение
# scripts/bootstrap-vps.sh:66 распространено на объявленное состояние, а не заменено).
BACKUP_DIR=/etc/nginx/sites-available
CONTENT_BACKUP_DIR=/var/backups/ikpk/current
RESTORE_CMD="bash /repo/scripts/restore-server-state.sh stand"

# --- Ревизия объявленного состояния (Requirement «Провижининг идемпотентен…») ---
PROVISION_REVISION=1

# --- Непрерывность раздачи ---
CONTINUITY_POLL_INTERVAL_MS=50

# --- Модель объявленных свойств (Requirement «…проверяет достигнутое состояние по покрытию») ---
PROPERTY_RELEASES_DIR_CLASS=auto
PROPERTY_SHARED_DIR_CLASS=auto
PROPERTY_VHOST_ENABLED_CLASS=auto
PROPERTY_VHOST_INCLUDE_CLASS=auto
PROPERTY_VHOST_GZIP_CLASS=auto
PROPERTY_REDIRECTS_FILE_CLASS=auto
PROPERTY_NGINX_RUNNING_CLASS=auto
PROPERTY_DEFAULT_SITE_DISABLED_CLASS=auto
PROPERTY_REVISION_RECORDED_CLASS=auto
PROPERTY_PACKAGES_INSTALLED_CLASS=auto
PROPERTY_CMS_DATA_DIR_CLASS=auto
PROPERTY_SERVICE_ACCOUNT_CLASS=auto
PROPERTY_SERVICE_UNIT_CLASS=auto
PROPERTY_SERVICE_ADDR_LOOPBACK_CLASS=auto
PROPERTY_SERVICE_PROXY_CLASS=auto

# Два исключения из tasks.md, раздел 0 — ручная приёмка, а не автоматическая проверка.
PROPERTY_TLS_SURVIVES_CLASS=manual
PROPERTY_TLS_SURVIVES_EVIDENCE=1:docs/evidence/tls-survives.md
PROPERTY_BACKUP_VOLUME_CLASS=manual
PROPERTY_BACKUP_VOLUME_EVIDENCE=1:docs/evidence/backup-volume.md
