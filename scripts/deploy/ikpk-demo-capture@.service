[Unit]
Description=IKPK coherent demo snapshot %i

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
Environment=NODE_OPTIONS= NODE_PATH=
ExecStart=/usr/bin/node /opt/ikpk/capture/scripts/server-capture.mjs capture %i
ExecStopPost=/usr/bin/node /opt/ikpk/capture/scripts/server-capture.mjs resume %i
TimeoutStartSec=300
TimeoutStopSec=180
KillMode=control-group
NoNewPrivileges=yes
