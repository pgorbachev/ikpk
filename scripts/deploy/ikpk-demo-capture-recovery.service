[Unit]
Description=Resume IKPK demo writers after interrupted capture
After=local-fs.target network.target

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
Environment=NODE_OPTIONS= NODE_PATH=
ExecStart=/usr/bin/node /opt/ikpk/capture/scripts/server-capture.mjs recover-leases
TimeoutStartSec=600
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
