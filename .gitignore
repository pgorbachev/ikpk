# Dependencies
# Без завершающего слэша: git считает symlink файлом, и `node_modules/` его не прячет.
node_modules
.pnp.*
.yarn/

# Build output
cms/dist/
cms/build/
cms/.cache/
cms/.tmp/
web/dist/
# Вывод демо-сборки — отдельный каталог, чтобы проверки боевого и демо-вывода не
# получали на вход чужой предмет (change deploy-gated-on-tests, решение 6).
web/dist-demo/
# Вывод сборки роли `stand` — артефакт браузерного набора этой роли (задача 6.15
# change online-payment-flow).
web/dist-stand/
web/.astro/

# Environment
.env
.env.*
!.env.example

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# Local tooling config (MCP servers etc.)
.mcp.json
.playwright-mcp/

# Внутренние worktree агентов (`git worktree add .claude/worktrees/…`).
# Каталог рабочий, а не артефакт: он висел в `git status` как untracked и
# попадал в выводы поиска по репозиторию — то есть grep находил ВТОРУЮ копию
# дерева и отвечал про неё. Игнорируем только `worktrees/`, а не `.claude/`
# целиком: там же лежит закоммиченная интеграция OpenSpec
# (`.claude/commands/opsx/**`, `.claude/skills/**` — 12 файлов), и правило на
# весь каталог заставляло бы `git add` отказывать без `-f`. Та же причина, что
# у `.codex/` ниже.
.claude/worktrees/

# Strapi uploads (local dev)
cms/public/uploads/

# Strapi SQLite DB (local dev)
cms/*.db
cms/*.db-journal

# Deprecated files
discovery/media_inventory_proxy_urls_DEPRECATED.json

# Large audit data (keep in repo for reference)
# lh_*.json — Lighthouse reports
# *.html — saved page snapshots
web/test-results/
.lighthouseci/

# Отдаваемые версии изображений генерируются из media-originals/ скриптом
# scripts/make-derivatives.ts (prebuild). В git держим только оригиналы —
# они единственная копия: бакет старого сайта умрёт при переключении DNS.
web/public/media/

# личные файлы владельца и настройки сторонних инструментов
#
# Каталог `.codex/` целиком игнорировать НЕЛЬЗЯ: после перехода на SDD туда
# закоммичена общая интеграция OpenSpec (`.codex/skills/**`), и правило на весь
# каталог заставляло бы `git add` отказывать без `-f`, а новые файлы после
# апгрейда генератора пропадали бы молча. Игнорируем только личное.
.codex/config.toml
.codex/*.local.*
*.docx
