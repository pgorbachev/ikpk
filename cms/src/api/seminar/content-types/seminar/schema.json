{
  "kind": "collectionType",
  "collectionName": "seminars",
  "info": {
    "singularName": "seminar",
    "pluralName": "seminars",
    "displayName": "Seminar",
    "description": "Educational seminar or course"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "description": {
      "type": "richtext",
      "required": true
    },
    "full_text": {
      "type": "richtext"
    },
    "learning_plan": {
      "type": "richtext"
    },
    "learning_mode": {
      "type": "richtext"
    },
    "recommendations": {
      "type": "richtext"
    },
    "image": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images"
      ]
    },
    "order": {
      "type": "integer",
      "default": 0
    },
    "documents_state": {
      "type": "enumeration",
      "enum": [
        "issued",
        "not-issued",
        "unconfirmed"
      ],
      "required": true
    },
    "documents": {
      "type": "component",
      "component": "seminar.document-record",
      "repeatable": true
    },
    "legacy_id": {
      "type": "string",
      "unique": true
    },
    "course_group": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::course-group.course-group",
      "inversedBy": "seminars",
      "required": true
    },
    "teachers": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::teacher.teacher",
      "inversedBy": "seminars"
    },
    "schedule_entries": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::schedule-entry.schedule-entry",
      "mappedBy": "seminar"
    },
    "seo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false,
      "required": true
    }
  }
}
