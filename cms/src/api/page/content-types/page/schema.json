{
  "kind": "collectionType",
  "collectionName": "pages",
  "info": {
    "singularName": "page",
    "pluralName": "pages",
    "displayName": "Page",
    "description": "Static page"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": false
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": false
    },
    "body": {
      "type": "richtext",
      "required": false
    },
    "legacy_id": {
      "type": "string",
      "unique": true
    },
    "seo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false,
      "required": false
    },
    "center_phone": {
      "type": "string",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "slug"
            },
            "kontakty"
          ]
        }
      }
    },
    "manager_phone": {
      "type": "string",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "slug"
            },
            "kontakty"
          ]
        }
      }
    },
    "student_document_form_url": {
      "type": "string",
      "conditions": { "visible": { "==": [{ "var": "slug" }, "oplata"] } }
    }
  },
  "config": {
    "metadatas": {
      "center_phone": {
        "edit": {
          "label": "Телефон центра",
          "description": "Телефоны для сайта задаются в этих двух полях. Текст Body на странице /kontakty не выводится."
        }
      },
      "manager_phone": {
        "edit": {
          "label": "Мобильный телефон менеджера"
        }
      },
      "student_document_form_url": {
        "edit": {
          "label": "Ссылка на форму заполнения документов"
        }
      }
    }
  }
}
