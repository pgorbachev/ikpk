{
  "kind": "collectionType",
  "collectionName": "schedule_entries",
  "info": {
    "singularName": "schedule-entry",
    "pluralName": "schedule-entries",
    "displayName": "Проведение",
    "description": "Дата и город проведения семинара"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": false
    },
    "admin_label": {
      "type": "string"
    },
    "startAt": {
      "type": "datetime",
      "customField": "global::wall-clock-datetime",
      "required": false
    },
    "endAt": {
      "type": "datetime",
      "customField": "global::wall-clock-datetime",
      "required": false
    },
    "city": {
      "type": "string",
      "required": false
    },
    "price": {
      "type": "decimal"
    },
    "oldPrice": {
      "type": "decimal"
    },
    "isFree": {
      "type": "boolean",
      "default": false
    },
    "entry_status": {
      "type": "enumeration",
      "enum": [
        "active",
        "cancelled",
        "completed"
      ],
      "default": "active",
      "required": false
    },
    "registrationFormLink": {
      "type": "string"
    },
    "description": {
      "type": "richtext"
    },
    "additionalText": {
      "type": "richtext"
    },
    "duration": {
      "type": "string"
    },
    "legacy_id": {
      "type": "string",
      "unique": true
    },
    "seminar": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::seminar.seminar",
      "inversedBy": "schedule_entries",
      "required": false
    },
    "teachers": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::teacher.teacher"
    }
  }
}
